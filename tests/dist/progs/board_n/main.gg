// Board n of many: joins as test.name, exports echo, waits until it sees
// test.count nodes, then Calls the next board's echo through the relay.
// With test.at (Unix ms) it joins at that moment, with every other board.
package main

import (
	"gogo/actor"
	"gogo/node"
	"gogo/strconv"
	"gogo/sys"
)

func echo(name string) {
	for {
		switch m := actor.Receive().(type) {
		case actor.Request:
			switch s := m.Body.(type) {
			case string:
				actor.Reply(m, s+" from "+name)
			}
		}
	}
}

// join is node.Connect retried with backoff and jitter, as the book
// recommends (20.3): the server may be busy (errors.Busy: at its
// handshake limit) or not up yet. It prints the last error if it gives up
// (and here every error, for the test to count).
func join(addr, name string) error {
	wait := 100
	for i := 1; ; i++ {
		err := node.Connect(addr, name)
		if err == nil {
			return nil
		}
		if i == 6 {
			println(name, "connect failed:", err.Error())
			return err
		}
		println(name, "retry:", err.Error())
		actor.Sleep(wait + sys.Random()%wait)
		wait *= 2
	}
}

func main() {
	addr, _ := sys.Config("test.server")
	name, _ := sys.Config("test.name")
	next, _ := sys.Config("test.next")
	c, _ := sys.Config("test.count")
	count, _ := strconv.Atoi(c)
	// Registered before joining: a node is announced (Up) as soon as the
	// server opens its link, before Connect returns here, so the others
	// may look echo up at once.
	node.Register("echo", actor.Spawn(func() { echo(name) }))
	if a, ok := sys.Config("test.at"); ok {
		at, _ := strconv.ParseInt64(a, 10)
		if sys.Time() >= at {
			println(name, "late")
		}
		for sys.Time() < at {
			actor.Sleep(1)
		}
	}
	if join(addr, name) != nil {
		return
	}
	for i := 0; i < 400 && len(node.Nodes()) < count; i++ {
		actor.Sleep(50)
	}
	if len(node.Nodes()) < count {
		println(name, "sees", len(node.Nodes()), "nodes")
		return
	}
	p, werr := node.Whereis(next, "echo", 3000)
	ok := werr == nil
	if !ok {
		println(name, "no echo on", next)
		return
	}
	r, err := actor.Call(p, "hi", 3000)
	if s, ok := r.(string); ok {
		println(name, err == nil, s)
	}
	actor.Receive()
}
