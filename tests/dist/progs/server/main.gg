// The server node of the distribution tests: echo, victim and victim2
// are reachable by name; joins and losses are printed.
package main

import (
	"gogo/actor"
	"gogo/node"
	"gogo/strconv"
	"gogo/sys"
)

// Ping and Pong cross nodes by name and field count: the boards declare
// the same types.
type Ping struct {
	From actor.PID
	N    int
}

type Pong struct {
	N    int
	Node string
}

func echo() {
	for {
		switch m := actor.Receive().(type) {
		case actor.Request:
			switch b := m.Body.(type) {
			case Dir: // known here, as the program uses them
				actor.Reply(m, b)
			case F:
				actor.Reply(m, b)
			default:
				actor.Reply(m, m.Body)
			}
		case Ping:
			actor.Send(m.From, Pong{N: m.N + 1, Node: "server"})
		}
	}
}

// Shape has the same name and field count as board a's, but another
// field kind: a's Shape never reaches shaper.
type Shape struct {
	A int
	B string
}

func shaper() {
	for {
		switch m := actor.Receive().(type) {
		case actor.Request:
			switch m.Body.(type) {
			case Shape:
				actor.Reply(m, "shape ok")
			}
		}
	}
}

// Dir and F are boxer's: echo gives them back as they came.
type Dir int

type F struct {
	X float64
	Y float32
}

// slow never answers.
func slow() {
	for {
		actor.Receive()
	}
}

// victim exits with code when it gets "die".
func victim(code int) {
	for {
		switch m := actor.Receive().(type) {
		case string:
			if m == "die" {
				actor.Exit(code)
			}
		}
	}
}

func main() {
	p, _ := sys.Config("test.port")
	port, _ := strconv.Atoi(p)
	node.Subscribe()
	if node.Listen(port, "server") != nil {
		println("listen failed")
		return
	}
	node.Register("echo", actor.Spawn(echo))
	node.Register("victim", actor.Spawn(func() { victim(123) }))
	node.Register("victim2", actor.Spawn(func() { victim(124) }))
	node.Register("victim3", actor.Spawn(func() { victim(0) }))
	node.Register("victim4", actor.Spawn(func() { victim(0) }))
	node.Register("shape", actor.Spawn(shaper))
	node.Register("slow", actor.Spawn(slow))
	println("listening")
	for {
		switch m := actor.Receive().(type) {
		case node.Up:
			println("up", m.Node)
		case node.Down:
			println("down", m.Node)
		}
	}
}
