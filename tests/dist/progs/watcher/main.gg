// The watcher monitors the server's echo, then loses the server.
package main

import (
	"gogo/actor"
	"gogo/errors"
	"gogo/node"
	"gogo/sys"
)

type callResult struct{ Lost, Fast bool }

// join is node.Connect retried with backoff and jitter, as the book
// recommends (20.3): the server may be busy (errors.Busy: at its
// handshake limit) or not up yet. It prints the last error if it gives up.
func join(addr, name string) error {
	wait := 100
	for i := 1; ; i++ {
		err := node.Connect(addr, name)
		if err == nil {
			return nil
		}
		if i == 6 {
			println(name, "connect failed:", err.Error())
			return err
		}
		actor.Sleep(wait + sys.Random()%wait)
		wait *= 2
	}
}

func main() {
	addr, _ := sys.Config("test.server")
	if join(addr, "w") != nil {
		return
	}
	node.Subscribe()
	echo, _ := node.Whereis("server", "echo", 2000)
	slow, _ := node.Whereis("server", "slow", 2000)
	ref := actor.Monitor(echo)
	self := actor.Self()
	// A Call in flight when the server goes fails at once, NoConnection.
	actor.Spawn(func() {
		t0 := actor.Now()
		_, err := actor.Call(slow, "hello", 10000)
		actor.Send(self, callResult{Lost: err == errors.NoConnection, Fast: actor.Now()-t0 < 5000})
	})
	actor.TrapExit(true)
	actor.Link(echo)
	println("w ready")
	n := 0
	for n < 4 {
		m, ok := actor.ReceiveTimeout(10000)
		if !ok {
			println("timeout")
			return
		}
		switch e := m.(type) {
		case actor.DownMsg:
			println("down", e.Ref == ref, e.Reason.Code)
			n++
		case actor.ExitMsg:
			println("exit", e.Reason.Code)
			n++
		case node.Down:
			println("node down", e.Node)
			n++
		case callResult:
			println("call in flight lost", e.Lost, e.Fast)
			n++
		}
	}
	// A Call to a PID of a node that is gone fails at once, NoConnection.
	t0 := actor.Now()
	_, err := actor.Call(echo, "hi", 5000)
	println("call to lost node", err == errors.NoConnection, actor.Now()-t0 < 1000)
	println("connect again", node.Connect(addr, "w") == nil)
}
