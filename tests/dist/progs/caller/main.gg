// More Calls in flight to the server than the board can track (it runs
// with --max-links 1: 9 entries); when the server goes, every one of them
// ends at once with errors.NoConnection: tracked ones on the node's loss,
// the rest when made.
package main

import (
	"gogo/actor"
	"gogo/errors"
	"gogo/node"
	"gogo/sys"
)

func call(slow actor.PID, i int, done actor.PID) {
	_, err := actor.Call(slow, i, 30000)
	actor.Send(done, err == errors.NoConnection)
}

func main() {
	addr, _ := sys.Config("test.server")
	println("connect", node.Connect(addr, "caller") == nil)
	slow, werr := node.Whereis("server", "slow", 2000)
	ok := werr == nil
	println("slow", ok)
	self := actor.Self()
	for i := 0; i < 12; i++ {
		k := i
		actor.Spawn(func() { call(slow, k, self) })
	}
	actor.Sleep(300)
	println("calling")
	lost := 0
	for lost < 12 {
		m, ok := actor.ReceiveTimeout(5000)
		if !ok {
			break
		}
		if b, _ := m.(bool); b {
			lost++
		}
	}
	println("lost", lost)
}
