// More Calls in flight to the server than the board can track (it runs
// with --max-links 1: 9 entries); when the server goes, every one of them
// ends at once with errors.NoConnection: tracked ones on the node's loss,
// the rest when made.
package main

import (
	"gogo/actor"
	"gogo/errors"
	"gogo/node"
	"gogo/sys"
)

func call(slow actor.PID, i int, done actor.PID) {
	_, err := actor.Call(slow, i, 30000)
	actor.Send(done, err == errors.NoConnection)
}

// join is node.Connect retried with backoff and jitter, as the book
// recommends (20.3): the server may be busy (errors.Busy: at its
// handshake limit) or not up yet. It prints the last error if it gives up.
func join(addr, name string) error {
	wait := 100
	for i := 1; ; i++ {
		err := node.Connect(addr, name)
		if err == nil {
			return nil
		}
		if i == 6 {
			println(name, "connect failed:", err.Error())
			return err
		}
		actor.Sleep(wait + sys.Random()%wait)
		wait *= 2
	}
}

func main() {
	addr, _ := sys.Config("test.server")
	println("connect", join(addr, "caller") == nil)
	slow, werr := node.Whereis("server", "slow", 2000)
	ok := werr == nil
	println("slow", ok)
	self := actor.Self()
	for i := 0; i < 12; i++ {
		k := i
		actor.Spawn(func() { call(slow, k, self) })
	}
	actor.Sleep(300)
	println("calling")
	lost := 0
	for lost < 12 {
		m, ok := actor.ReceiveTimeout(5000)
		if !ok {
			break
		}
		if b, _ := m.(bool); b {
			lost++
		}
	}
	println("lost", lost)
}
