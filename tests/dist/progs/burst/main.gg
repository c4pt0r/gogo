// A board that sends a burst of big messages to the server, more than its
// link actor queues: some are dropped, the link stays up.
package main

import (
	"gogo/actor"
	"gogo/node"
	"gogo/sys"
)

func main() {
	addr, _ := sys.Config("test.server")
	node.Subscribe()
	println("connect", node.Connect(addr, "burst") == nil)
	slow, werr := node.Whereis("server", "slow", 2000)
	ok := werr == nil
	println("slow", ok)
	b := make([]byte, 3500)
	for i := range b {
		b[i] = 120
	}
	big := string(b)
	for i := 0; i < 16; i++ {
		actor.Send(slow, big)
	}
	actor.Sleep(500)
	_, werr = node.Whereis("server", "echo", 2000)
	ok = werr == nil
	println("echo after burst", ok)
	for {
		m, ok := actor.ReceiveTimeout(1000)
		if !ok {
			break
		}
		switch d := m.(type) {
		case node.Down:
			println("down", d.Node)
		}
	}
	println("end")
}
