// Dials, writes "abc" then "def" (the peer never acknowledges it), then
// dials with a 2.5 s connect timeout nobody answers.
package main

import (
	"gogo/actor"
	"gogo/bytes"
	"gogo/net"
	"gogo/port"
)

func main() {
	n, _ := port.Open("netif", net.IfConfig{})
	actor.Send(n, net.SetAddr{IP: 10<<24 | 2, Mask: -256, Gateway: 10<<24 | 1})
	actor.Sleep(100)
	c, err := port.Open("tcp", net.Dial{IP: 10<<24 | 1, Port: 80})
	println("dial", err == nil)
	done := false
	for !done {
		switch m := actor.Receive().(type) {
		case net.Connected:
			println("connected")
			actor.Send(c, port.Out{Data: bytes.FromString("abc")})
		case port.Done:
			if m.Seq < 0 {
				println("not sent")
			} else {
				println("written")
				actor.Send(c, port.Out{Data: bytes.FromString("def")})
			}
		case port.Closed:
			println("closed", m.Reason, actor.Now())
			port.Close(c)
			done = true
		}
	}
	c, err = port.Open("tcp", net.Dial{IP: 10<<24 | 1, Port: 81, TimeoutMs: 2500})
	println("dial2", err == nil)
	switch m := actor.Receive().(type) {
	case port.Closed:
		println("closed", m.Reason, actor.Now())
	}
}
