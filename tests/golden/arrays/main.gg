package main

type Point struct{ X, Y int }

type Grid struct {
	Cells [3][3]int
	Name  string
	Pts   [2]Point
}

func sum(a [4]int) int {
	t := 0
	for _, v := range a {
		t += v
	}
	a[0] = 1000 // the caller's array is unchanged
	return t
}

func double(a [4]int) [4]int {
	for i := range a {
		a[i] *= 2
	}
	return a
}

func named() (r [3]int, s []int) {
	r[0] = 7
	s = r[:]
	return
}

func pr(a [4]int) {
	println(a[0], a[1], a[2], a[3])
}

func main() {
	var a [4]int
	a[1] = 5
	a[2]++
	a[3] += 9
	b := a
	b[0] = 42
	pr(a)
	pr(b)
	println(len(a), cap(a), sum(a), a[0])
	pr(double(a))
	pr(a)

	// Slicing shares the variable's array; assignment copies into it.
	s := a[:]
	s[0] = -1
	println(a[0])
	a = b
	println(s[0], s[1])
	t := a[1:3]
	println(len(t), cap(t))
	t = append(t, 77) // writes a[3]: cap reaches the array's end
	println(a[3])

	// Literals.
	c := [...]string{"x", "y", "z"}
	println(len(c), c[0]+c[2])
	k := [6]int{2: 20, 4: 40, 50}
	pr([4]int{k[0], k[2], k[4], k[5]})
	ps := [2]Point{{1, 2}, {3, 4}}
	ps[1].X = 30
	q := ps
	q[0].Y = 200
	println(ps[0].Y, ps[1].X, q[0].Y, q[1].X)

	// Nested arrays.
	var m [2][3]int
	m[1][2] = 5
	m2 := m
	m2[1][2]++
	m2[0][0] = 9
	println(m[1][2], m2[1][2], m[0][0], m2[0][0])
	row := m2[1]
	row[0] = 4
	println(m2[1][0], row[0])
	for _, r := range m2 {
		r[1] = 100 // a copy
	}
	println(m2[0][1])

	// Arrays in struct fields.
	g := Grid{Name: "g"}
	g.Cells[1][1] = 5
	g.Pts[1].Y = 8
	h := g
	h.Cells[1][1] = 6
	h.Pts[1].Y++
	println(g.Cells[1][1], h.Cells[1][1], g.Pts[1].Y, h.Pts[1].Y)
	cs := g.Cells
	cs[0][0] = 1
	println(g.Cells[0][0], cs[0][0])
	g.Cells = cs
	println(g.Cells[0][0])

	// Slices of arrays.
	rows := make([][2]int, 2)
	rows[0][1] = 3
	cp := make([][2]int, 2)
	copy(cp, rows)
	cp[0][1] = 4
	rows = append(rows, [2]int{5, 6})
	println(rows[0][1], cp[0][1], rows[2][1], len(rows))

	r, sl := named()
	sl[0] = 8
	println(r[0], sl[0])

	var bs [4]byte
	bs[0] = 'h'
	bs[1] = 'i'
	bs[2] = 255
	bs[2]++
	println(string(bs[:2]), bs[2])

	// Range over a local array ranges over a copy.
	w := [3]int{1, 2, 3}
	got := 0
	for i, v := range w {
		if i == 0 {
			w[2] = 100
		}
		got = got*10 + v
	}
	println(got, w[2])
}
