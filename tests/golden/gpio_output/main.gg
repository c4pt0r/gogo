// Writes to an output pin print "gpio: pin N = V" on stderr.
package main

import (
	"gogo/actor"
	"gogo/gpio"
	"gogo/port"
)

func main() {
	p, err := port.Open("gpio", gpio.Config{Pin: 5, Mode: gpio.Output})
	println(err == nil)
	actor.Send(p, gpio.Write{Value: 1})
	actor.Send(p, gpio.Write{Value: 0})
	port.Close(p)
	println("done")
}
