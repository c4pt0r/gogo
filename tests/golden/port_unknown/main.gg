// Open of a driver the platform does not have fails; Close of the PID a
// failed Open returned is a no-op. The directive keeps the image from
// requiring the absent driver.
//
//gogo:optional nosuch
package main

import (
	"gogo/actor"
	"gogo/gpio"
	"gogo/port"
)

func main() {
	p, ok := port.Open("nosuch", gpio.Config{Pin: 1, Mode: gpio.Output, Edge: gpio.None})
	println(ok)
	port.Close(p)
	var q actor.PID
	q, ok = port.Open("nosuch", 5)
	println(ok)
	port.Close(q)
	println("done")
}
