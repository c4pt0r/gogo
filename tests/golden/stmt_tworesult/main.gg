// A two-result builtin called as a statement, or deferred, runs, its
// results discarded.
package main

import (
	"gogo/actor"
	"gogo/sys"
)

func main() {
	actor.Send(actor.Self(), "first")
	actor.ReceiveTimeout(0) // takes "first"
	_, ok := actor.ReceiveTimeout(0)
	println("mailbox empty:", !ok)

	s := actor.Spawn(func() {
		n := 0
		for {
			r := actor.Receive().(actor.Request)
			n++
			actor.Reply(r, n)
		}
	})
	actor.Call(s, "count me", 100)
	(actor.Call(s, "and me", 100))
	n, _ := actor.Call(s, "how many?", 100)
	println("calls:", n)

	actor.Whereis("nobody")
	sys.Config("no.such.key")
	deferred()
	_, ok = actor.ReceiveTimeout(0)
	println("deferred ReceiveTimeout took the message:", !ok)
	println("done")
}

// deferred defers two-result builtins: they run when it returns, last
// first, and drop their results (ReceiveTimeout takes the queued message).
func deferred() {
	defer actor.ReceiveTimeout(0)
	defer actor.Whereis("x")
	defer sys.Config("k")
	actor.Send(actor.Self(), "queued")
}
