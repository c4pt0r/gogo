// Package-level variables (15.6): read-only, and set when the program is
// built, from constants, literals, conversions, other package-level
// variables and calls of single-return functions such as errors.New. The
// values live in the image's constant area. Valid Go: `go run` prints the
// same.
package main

import "gogo/errors"

type Point struct{ X, Y int }

type Celsius int

func (c Celsius) Hot() bool { return c > 30 }

func at(x, y int) Point { return Point{x, y} }

var (
	count            = 3
	big              = 3000000000 >> 1
	big64      int64 = 1 << 40
	name             = "gogo"
	origin           = Point{1, 2}
	far              = at(10, 20)
	primes           = []int{2, 3, 5, 7, 11}
	grid             = [3]int{1, 2, 3}
	sparse           = [5]int{2: 7, 4: 9}
	names            = []string{"a", "b"}
	crc              = []byte{0xde, 0xad, 0xbe, 0xef}
	raw              = []byte("hi")
	ErrBad           = errors.New("bad thing")
	anyv       any   = int64(5)
	temp       any   = Celsius(31)
	points           = []Point{{1, 1}, {2, 2}}
	empty            = []int{}
	nothing    []int
	zero       Point
	half       float32 = 0.5
	nested             = [][]int{{1}, {2, 3}}
	alias              = primes
	firstX             = origin.X
	unset      error
	celsiusNow = Celsius(25)
)

func sum(xs []int) int {
	s := 0
	for _, x := range xs {
		s += x
	}
	return s
}

func check(fail bool) error {
	if fail {
		return ErrBad
	}
	return nil
}

func main() {
	println(count, big, big64, name, origin.X, origin.Y, far.X, far.Y)
	println(len(primes), primes[4], grid[1], sparse[2], sparse[3], sparse[4], len(sparse))
	println(names[1], crc[1], string(raw), ErrBad.Error(), check(true) == ErrBad, check(false) == nil)
	println(anyv.(int64), temp.(Celsius).Hot(), celsiusNow.Hot(), points[1].Y, len(empty), empty == nil, nothing == nil)
	println(zero.X, half*4, len(nested[1]), alias[4], firstX, unset == nil)
	println(sum(primes), sum(primes[1:3]), sum(grid[:]))

	// A copy is writable; the variable keeps its value.
	u := append(primes, 13)
	u[0] = 100
	println(u[0], primes[0], len(u), len(primes))
	g := grid
	g[0] = 50
	println(g[0], grid[0])
	c := make([]int, 2)
	copy(c, primes)
	c[0]++
	println(c[0], c[1], primes[0])
	for i, p := range points {
		println(i, p.X+p.Y)
	}
}
