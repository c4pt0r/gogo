// The variables of a range loop (over a slice, a string, an array and an
// int) and a type switch's binder can be pointed to and written by a
// closure: each pass and each clause has its own (Go 1.22). Valid Go:
// `go run` prints the same.
package main

func bump(x any) func() int {
	switch v := x.(type) {
	case int:
		return func() int { v++; return v }
	case string:
		p := &v
		*p += "!"
		return func() int { return len(v) }
	}
	return func() int { return 0 }
}

func main() {
	for _, v := range []int{1, 2} {
		p := &v
		*p *= 10
		println(*p, v)
	}
	var fs []func() int
	for i := range 3 {
		fs = append(fs, func() int { i++; return i })
	}
	println(fs[0](), fs[0](), fs[1](), fs[2]())
	var ps []*int
	for i := range 3 {
		ps = append(ps, &i)
	}
	println(*ps[0], *ps[1], *ps[2])
	var rs []*rune
	for _, r := range "hey" {
		rs = append(rs, &r)
	}
	println(*rs[0], *rs[2])
	var is []*int
	for i, x := range [3]int{7, 8, 9} {
		is = append(is, &i, &x)
	}
	println(*is[0], *is[1], *is[4], *is[5])
	f := bump(4)
	println(f(), f())
	g := bump("ab")
	println(g())
	switch v := any(5).(type) {
	case int:
		p := &v
		*p += 1
		println(v)
	}
}
