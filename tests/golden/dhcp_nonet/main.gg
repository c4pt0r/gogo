// Without a network dhcp.Start fails at once, with port.Open's error for
// the "netif" port (the host VM's refuses: busy); the client exits.
package main

import (
	"gogo/actor"
	"gogo/dhcp"
)

func main() {
	err := dhcp.Start(dhcp.Config{})
	println("start", err != nil, err.Error(), actor.Now())
}
