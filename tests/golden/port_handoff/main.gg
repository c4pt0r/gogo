// port.Handoff moves a port to another actor: only the owner may hand it
// off, and afterwards the new owner's exit closes it, so the pin can be
// opened again.
package main

import (
	"gogo/actor"
	"gogo/gpio"
	"gogo/port"
)

type Take struct{ P actor.PID }

type Quit struct{}

func holder(boss actor.PID) {
	m := actor.Receive()
	switch t := m.(type) {
	case Take:
		println("child steals", port.Handoff(t.P, actor.Self()))
	}
	actor.Send(boss, Quit{})
	actor.Receive()
}

func main() {
	p, err := port.Open("gpio", gpio.Config{Pin: 5, Mode: gpio.Output})
	println("open", err == nil)
	me := actor.Self()
	c := actor.Spawn(func() { holder(me) })
	actor.Send(c, Take{p})
	actor.Receive()
	var zero actor.PID
	println("to zero pid", port.Handoff(p, zero))
	println("to child", port.Handoff(p, c))
	println("again", port.Handoff(p, c))
	_, err = port.Open("gpio", gpio.Config{Pin: 5, Mode: gpio.Output})
	println("reopen while child owns", err == nil)
	ref := actor.Monitor(c)
	actor.Send(c, Quit{})
	actor.Receive()
	_ = ref
	_, err = port.Open("gpio", gpio.Config{Pin: 5, Mode: gpio.Output})
	println("reopen after child exit", err == nil)
}
