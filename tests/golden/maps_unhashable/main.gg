// A key of a map[any]V that cannot be a key ends the actor with a panic,
// as in Go: a slice or a map ("hash of unhashable type"); gogo also
// refuses a pointer, which it cannot order (Go would accept it).
package main

import "gogo/actor"

type P struct{ X int }

func watch(f func()) {
	p := actor.Spawn(f)
	actor.Monitor(p)
	d := actor.Receive().(actor.DownMsg)
	println(d.Reason.Code == actor.Panic, d.Reason.Func)
}

func main() {
	m := map[any]int{P{1}: 1, "a": 2}
	println(m[P{1}], m["a"], len(m))
	watch(func() { m[[]int{1}] = 3 })
	watch(func() { println(m[&P{1}]) })
	watch(func() { delete(m, map[int]int{}) })
	println(len(m))
}
