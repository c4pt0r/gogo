// logup: the board streams its log lines to a collector on your computer,
// in real time, over Wi-Fi (or over the USB serial link).
//
//	host (Linux or macOS)                       board
//	---------------------                       -----
//	go run ./examples/logup/host -addr :8080    gogo config set logup.url \
//	                                              'http://<host-ip>:8080/ingest?board=cardputer'
//	                                            gogo flash examples/logup
//
//	go run ./examples/logup/host -stdin         # or over the serial link, no network:
//	                                            gogo monitor -reset -timeout 60 |
//	                                              go run ./examples/logup/host -stdin
//
// The data is whatever this board actually has. Each source is one actor:
// the motion sensor (the `imu` stream port: 12-byte samples arrive as a
// port.Chunk every BatchMs, book 15), the keyboard (the `kbd` port, Cardputer),
// the microphone (the `mic` stream port: 16-bit little-endian PCM, logged as
// a level, not as audio), the network (gogo/net's Up and Down) and a
// heartbeat, so the collector sees that the board is alive even when nothing
// happens. A source whose port refuses to open logs that and exits: the
// collector uploads the reason, which is exactly what a device log is for.
//
// Lines are batched and each batch is POSTed through one keep-alive
// gogo/http client, so a batch costs a request, not a connection. Lines are
// printed as they are made too, so the serial link collects them with no
// network at all (`gogo monitor` into the collector's -stdin).
//
// Config (gogo config set <key> <value> on a board; `gogo run --config
// FILE` on the host): logup.url the collector (unset: print only),
// logup.src the sources to try, comma separated: imu,kbd,mic (all three by
// default), logup.beat ms between heartbeat lines (5000, 0 to stop them),
// logup.batch lines per POST (4), logup.max lines kept while the upload
// fails (48; the oldest are dropped and counted), logup.attempts POSTs per
// batch (3), logup.retry ms before the first retry (1000, doubling),
// logup.retrymax ms between retries at most (30000), logup.timeout ms per
// POST (3000), logup.sim N: write N log lines instead of reading ports and
// then stop (the golden test, and trying a collector without a board).
//
// Actor shape: one actor per job, none of them waiting on another. The
// sources only send lines; the uploader owns the HTTP client and answers
// nothing; the collector holds all the state (the batch on its way out, the
// backlog, the counters) and monitors the uploader. A reply is a message the
// collector addressed itself, not actor.Call: a Call would stop the
// collector for as long as the POST takes, and the log would stall behind a
// slow link. An uploader that dies takes its batch back into the backlog
// with it, because the batch was never the uploader's to keep.
package main

import (
	"gogo/actor"
	"gogo/audio"
	"gogo/bytes"
	"gogo/dhcp"
	"gogo/http"
	"gogo/imu"
	"gogo/kbd"
	"gogo/net"
	"gogo/port"
	"gogo/strconv"
	"gogo/sys"
)

// Post asks the uploader to send one batch; Sent is the answer. From rides
// along in the request so the answer finds its way back without anyone
// blocking.
type Post struct {
	From actor.PID
	Text string
}

type Sent struct {
	OK   bool
	Info string
}

// Link says whether the board has a network: a batch is never posted while
// it does not, because a POST with no link costs the radio and nothing
// else. Retry asks the collector to send the waiting batch again, Finish
// asks it to deliver what is left and stop, and Done tells the root actor
// the log is closed.
type Link struct{ Up bool }
type Retry struct{}
type Finish struct{}
type Done struct{}

func cfg(key, def string) string {
	v, ok := sys.Config(key)
	if !ok || v == "" {
		return def
	}
	return v
}

func cfgInt(key string, def int) int {
	n, err := strconv.Atoi(cfg(key, ""))
	if err != nil {
		return def
	}
	return n
}

// want reports whether a source is in logup.src (all of them by default).
func want(name string) bool {
	list := cfg("logup.src", "imu,kbd,mic")
	for len(list) > 0 {
		n := len(list)
		if i := indexOf(list, ","); i >= 0 {
			n = i
		}
		if list[:n] == name {
			return true
		}
		list = list[n:]
		if len(list) > 0 {
			list = list[1:]
		}
	}
	return false
}

func indexOf(s, sub string) int {
	for i := 0; i+len(sub) <= len(s); i++ {
		if s[i:i+len(sub)] == sub {
			return i
		}
	}
	return -1
}

// s16 is the little-endian int16 at byte i of a chunk. An imu sample is
// gx gy gz ax ay az, the accelerometer spanning +-8 g and the gyro +-2000
// degrees per second, both over +-32768 (book 15.2); a mic frame is 16-bit
// little-endian mono PCM.
func s16(b bytes.Bytes, i int) int {
	return int(int16(int(b.At(i)) | int(b.At(i+1))<<8))
}

func mg(raw int) int { return raw * 8000 / 32768 }

func dps(raw int) int { return raw * 2000 / 32768 }

// srcIMU logs one line per batch of motion samples.
func srcIMU(to actor.PID) {
	_, err := port.Open("imu", imu.Config{RateHz: 100, BatchMs: 200, Gestures: imu.Step})
	if err != nil {
		actor.Send(to, "imu: unavailable ("+err.Error()+")")
		return
	}
	for {
		switch m := actor.Receive().(type) {
		case port.Chunk:
			n := m.Data.Len() / 12
			if n > 0 {
				last := 12 * (n - 1)
				actor.Send(to, "imu samples="+strconv.Itoa(n)+
					" gx="+strconv.Itoa(dps(s16(m.Data, last)))+
					" gy="+strconv.Itoa(dps(s16(m.Data, last+2)))+
					" gz="+strconv.Itoa(dps(s16(m.Data, last+4)))+
					" ax="+strconv.Itoa(mg(s16(m.Data, last+6)))+
					" ay="+strconv.Itoa(mg(s16(m.Data, last+8)))+
					" az="+strconv.Itoa(mg(s16(m.Data, last+10)))+
					" dropped="+strconv.Itoa(m.Dropped))
			}
		case imu.Gesture:
			if m.Kind == imu.Step {
				actor.Send(to, "imu steps="+strconv.Itoa(m.Value))
			}
		}
	}
}

// srcKeys logs the keyboard. Both edges of a key are worth having: a stuck
// key shows up as a press with no release.
func srcKeys(to actor.PID) {
	_, err := port.Open("kbd", kbd.Config{RepeatDelayMs: 400, RepeatMs: 60})
	if err != nil {
		actor.Send(to, "kbd: unavailable ("+err.Error()+")")
		return
	}
	for {
		switch m := actor.Receive().(type) {
		case kbd.Key:
			d := 0
			if m.Down {
				d = 1
			}
			actor.Send(to, "key down="+strconv.Itoa(d)+" code="+strconv.Itoa(m.Code)+
				" char="+strconv.Itoa(m.Char)+" mods="+strconv.Itoa(m.Mods))
		}
	}
}

// srcMic logs a level per frame rather than the audio itself: a few hundred
// bytes of PCM per line would buy the collector nothing it can look at.
func srcMic(to actor.PID) {
	_, err := port.Open("mic", audio.Mic{RateHz: audio.Rate8k, FrameMs: 200})
	if err != nil {
		actor.Send(to, "mic: unavailable ("+err.Error()+")")
		return
	}
	for {
		switch m := actor.Receive().(type) {
		case port.Chunk:
			n := m.Data.Len() / 2
			peak, sum := 0, 0
			for i := 0; i < n; i++ {
				v := s16(m.Data, 2*i)
				if v < 0 {
					v = -v
				}
				if v > peak {
					peak = v
				}
				sum += v
			}
			mean := 0
			if n > 0 {
				mean = sum / n
			}
			actor.Send(to, "mic samples="+strconv.Itoa(n)+" peak="+strconv.Itoa(peak)+
				" mean="+strconv.Itoa(mean)+" dropped="+strconv.Itoa(m.Dropped))
		}
	}
}

// srcNet reports the link, and treats an Up as the moment to retry what the
// backlog still holds.
func srcNet(to actor.PID) {
	if !net.Subscribe() {
		actor.Send(to, "net: no netif port (the host VM needs --net-fd)")
		return
	}
	dhcp.Start(dhcp.Config{TimeoutMs: 5000})
	for {
		switch actor.Receive().(type) {
		case net.Up:
			actor.Send(to, Link{true})
			actor.Send(to, "net up")
		case net.Down:
			actor.Send(to, Link{false})
			actor.Send(to, "net down")
		}
	}
}

// beat keeps the log moving when the board has nothing to say: a collector
// that stops seeing beats has a dead board, not a quiet one.
func beat(to actor.PID, ms int) {
	for {
		actor.Sleep(ms)
		actor.Send(to, "beat t="+strconv.FormatInt64(actor.Now(), 10))
	}
}

// uploader sends batches over one keep-alive connection and keeps nothing of
// its own: kill it and the batch is still the collector's.
func uploader(url string, timeout int) {
	c := http.NewClient()
	for {
		switch m := actor.Receive().(type) {
		case Post:
			resp, err := http.ClientDo(c, "POST", url, "text/plain; charset=utf-8",
				bytes.FromString(m.Text), timeout)
			if err != nil {
				actor.Send(m.From, Sent{false, err.Error()})
			} else {
				actor.Send(m.From, Sent{resp.Status >= 200 && resp.Status < 300,
					"HTTP " + strconv.Itoa(resp.Status)})
			}
		}
	}
}

func joinLines(v []string) string {
	s := ""
	for _, x := range v {
		s += x + "\n"
	}
	return s
}

func collector(root actor.PID) {
	url := cfg("logup.url", "")
	batch := cfgInt("logup.batch", 4)
	max := cfgInt("logup.max", 48)
	attempts := cfgInt("logup.attempts", 3)
	retryMs := cfgInt("logup.retry", 1000)
	timeout := cfgInt("logup.timeout", 3000)

	var up actor.PID
	if url != "" {
		up = actor.Spawn(func() { uploader(url, timeout) })
		actor.Monitor(up)
		println("# logup: uploading to " + url + " (batch " + strconv.Itoa(batch) +
			", max " + strconv.Itoa(max) + ", attempts " + strconv.Itoa(attempts) + ")")
	}

	var tail []string // lines still waiting for a batch
	head := ""        // the batch on its way out; "" once it was delivered
	headN, tries := 0, 0
	sent, failed, lost, dropped := 0, 0, 0, 0
	flight, finishing, link := false, false, false
	retryMax := cfgInt("logup.retrymax", 30000)
	// nextTry is the earliest moment the waiting batch may go out again. The
	// backoff has to be a deadline, not just a timer message: pack() also
	// runs for every new log line, and without this the first line after a
	// failure posts the batch again at once, which turns a retry backoff into
	// "as fast as the log arrives".
	var nextTry int64

	// pack puts the next batch on its way. Nothing here waits: the POST
	// answer comes back as a message, so lines keep flowing while a batch is
	// in the air.
	pack := func() {
		if headN == 0 && len(tail) > 0 && (len(tail) >= batch || finishing) {
			n := len(tail)
			if n > batch {
				n = batch
			}
			head, headN, tries = joinLines(tail[:n]), n, 0
			tail = tail[n:]
		}
		if headN > 0 && !flight {
			if url == "" { // the serial transport: printing was the delivery
				sent += headN
				head, headN = "", 0
				return
			}
			if !link && !finishing { // no network: keep batching, do not post
				return
			}
			if nextTry > actor.Now() && !finishing { // still backing off
				return
			}
			flight = true
			actor.Send(up, Post{actor.Self(), head})
		}
	}

	// closeLog prints the tally once the last batch is settled: the run is
	// over when nothing is in the air, nothing waits and nothing is left.
	closeLog := func() {
		if finishing && !flight && headN == 0 && len(tail) == 0 {
			println("# done: " + strconv.Itoa(sent) + " lines sent, " +
				strconv.Itoa(failed) + " failed posts, " + strconv.Itoa(lost) +
				" lines lost, " + strconv.Itoa(dropped) + " dropped (backlog over " +
				strconv.Itoa(max) + ")")
			actor.Send(root, Done{})
		}
	}

	for {
		switch m := actor.Receive().(type) {
		case string: // a log line: print it (the serial transport) and queue it
			println(m)
			tail = append(tail, m)
			for len(tail)+headN > max { // the log outpaces the link: keep the newest
				tail = tail[1:]
				dropped++
			}
			// A long run must say so while it is happening, not only in the
			// closing tally: one status line per batch worth of losses.
			if dropped > 0 && dropped%batch == 0 {
				println("# backlog full: dropped " + strconv.Itoa(dropped) +
					" lines, keeping the newest " + strconv.Itoa(max))
			}
			pack()
			closeLog()
		case Sent:
			flight = false
			if m.OK {
				println("# delivered " + strconv.Itoa(headN) + " lines (" + m.Info + ")")
				sent += headN
				head, headN, nextTry = "", 0, 0
				pack()
			} else {
				failed++
				println("# send failed: " + m.Info)
				tries++
				if tries >= attempts {
					println("# giving up on " + strconv.Itoa(headN) + " lines")
					lost += headN
					head, headN = "", 0
					pack()
				} else if !finishing {
					// Backoff, capped: a collector that is down for an hour
					// should cost the board one POST every retryMax, not one
					// every retryMs, and should not fill its own log with the
					// same failure.
					delay := retryMs << uint(tries)
					if delay > retryMax || delay <= 0 {
						delay = retryMax
					}
					nextTry = actor.Now() + int64(delay)
					actor.SendAfter(delay, actor.Self(), Retry{})
				}
			}
			closeLog()
		case Link: // the network came back: retry at once, from the top
			link = m.Up
			if link {
				tries, nextTry = 0, 0
			}
			pack()
			closeLog()
		case Retry:
			pack()
			closeLog()
		case actor.DownMsg: // the uploader died with a batch in its hands
			if flight {
				flight = false
				failed++
				println("# uploader exited:", m.Reason)
				tries++
				if tries >= attempts {
					println("# giving up on " + strconv.Itoa(headN) + " lines")
					lost += headN
					head, headN = "", 0
				}
			}
			if !finishing {
				up = actor.Spawn(func() { uploader(url, timeout) })
				actor.Monitor(up)
				pack()
			}
			closeLog()
		case Finish:
			finishing = true
			nextTry = 0 // one last try, however recent the last failure was
			pack()
			closeLog()
		}
	}
}

// sim writes N log lines of its own: the same shape the ports produce, with
// no ports and no timing in it, so a run of it is reproducible.
func sim(to actor.PID, n int) {
	for i := 1; i <= n; i++ {
		actor.Send(to, "sim line "+strconv.Itoa(i)+" ax="+strconv.Itoa(mg(512*i))+
			" az="+strconv.Itoa(mg(512*(n-i)))+" peak="+strconv.Itoa(100*i))
	}
	actor.Send(to, Finish{})
}

func main() {
	root := actor.Self()
	c := actor.Spawn(func() { collector(root) })
	n := cfgInt("logup.sim", 0)
	if n > 0 {
		actor.Spawn(func() { sim(c, n) })
		for {
			switch actor.Receive().(type) {
			case Done:
				return
			}
		}
	}
	if want("imu") {
		actor.Spawn(func() { srcIMU(c) })
	}
	if want("kbd") {
		actor.Spawn(func() { srcKeys(c) })
	}
	if want("mic") {
		actor.Spawn(func() { srcMic(c) })
	}
	actor.Spawn(func() { srcNet(c) })
	if ms := cfgInt("logup.beat", 5000); ms > 0 {
		actor.Spawn(func() { beat(c, ms) })
	}
	for {
		actor.Receive() // the log runs until the board is reset
	}
}
