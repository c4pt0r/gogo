# Added to SDKCONFIG_DEFAULTS when the "bleprov" feature is on (Wi-Fi
# provisioning over BLE, main/ble_prov.c; `gogo firmware -with bleprov`
# does it, see cmd/gogo/firmware.go onDefaults; by hand:
# -DSDKCONFIG_DEFAULTS="sdkconfig.defaults;<board overlay>;sdkconfig.bleprov").
#
# NimBLE, a peripheral with one connection: provisioning advertises, a
# phone connects, nothing else. Its host task runs protocomm's security 2
# (SRP6a with a 3072-bit group, AES-GCM), hence the larger stack.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT=n
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=5120
# The controller's code in flash, not IRAM: ~20 KB more internal RAM at
# every boot (the Cardputer has no PSRAM). Provisioning runs before the
# program and writes flash only after the radio is off.
CONFIG_BT_CTRL_RUN_IN_FLASH_ONLY=y
# Protocomm: only security 2 (SRP6a + AES-GCM, a PIN as the proof of
# possession); 0 (none) and 1 (Curve25519 + AES-CTR) are not built.
CONFIG_ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_0=n
CONFIG_ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_1=n
CONFIG_ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_2=y
