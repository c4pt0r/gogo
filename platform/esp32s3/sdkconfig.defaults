CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
# Console (and stdout/stderr) on the built-in USB-Serial/JTAG port.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# 1 ms ticks so platform_wait timeouts have millisecond resolution.
CONFIG_FREERTOS_HZ=1000
# Keep the serial console to gogo's own output.
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
# The VM task runs on CPU1 and may keep it busy for long stretches.
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n
# Task notification index 1: console bring-up handshake (index 0 is the
# VM task's platform_wait).
CONFIG_FREERTOS_TASK_NOTIFICATION_ARRAY_ENTRIES=2
# Bigger caches: the VM (CPU1) and the LCD render task (CPU0) share them.
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
# Wi-Fi (M5): raw frames to gogo's own stack; driver buffers at the
# smallest configuration that works (measured; see README "Wi-Fi").
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=2
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=2
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=2
CONFIG_ESP_WIFI_RX_MGMT_BUF_NUM_DEF=1
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=6
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_NVS_ENABLED=n
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n
# Wi-Fi/lwIP code stays in flash: internal RAM goes to the VM arena.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_LWIP_IRAM_OPTIMIZATION=n
# LittleFS for /flash (main/fs_lfs.c): its raw lfs.h API. No malloc: every
# buffer is static and passed in; lfs.c is built without heap access (see
# CMakeLists.txt). The component's own VFS wrapper (unused) does not compile
# with CONFIG_LITTLEFS_MALLOC_STRATEGY_DISABLE, so that stays at default.
# Asserts off: an LFS_ASSERT on a corrupt partition would abort at every
# boot (a boot loop) instead of returning an error to fs_lfs.c.
CONFIG_LITTLEFS_EXPOSE_RAW_API=y
CONFIG_LITTLEFS_ASSERTS=n
# The I2C master ISR (shared bus, only scheduler-thread synchronous transfers)
# may live in flash: saves ~760 B of IRAM.
CONFIG_I2C_MASTER_ISR_HANDLER_IN_IRAM=n
# IR (ir_esp.c, GOGO_IR): the RMT ISRs and the copy encoder run from flash,
# not IRAM (about 3 KB of internal RAM). IR timings are hundreds of us, so a
# cache miss in the ISR does not matter; the ISR is not cache-safe either way
# (RMT_*_ISR_CACHE_SAFE stays off).
CONFIG_RMT_TX_ISR_HANDLER_IN_IRAM=n
CONFIG_RMT_RX_ISR_HANDLER_IN_IRAM=n
CONFIG_RMT_ENCODER_FUNC_IN_IRAM=n
# mbedTLS (the "tls" port, GOGO_TLS; runtime/net/tls/tls.h, spec HTTPS). These are the
# default build's settings (GOGO_TLS on); a TLS-off build adds
# sdkconfig.tls-off, which puts the ones that would also change Wi-Fi's WPA
# crypto (-O2, the allocator, restartable ECC, time) back to IDF's defaults
# (`gogo firmware` adds it by itself). The port uses
# ESP-IDF's own mbedTLS component (4.1.1, the source the host build compiles
# with runtime/net/tls/config), shared with Wi-Fi's WPA crypto; these mirror runtime/net/tls/config:
# - every mbedTLS allocation goes through esp_tls_hw's allocator
#   (platform_esp.c tls_mem_calloc, installed by platform_esp_init: PSRAM
#   first on the StickS3);
CONFIG_MBEDTLS_CUSTOM_MEM_ALLOC=y
# - certificate validity is checked against time() (gmtime_r), which reads
#   the system clock that gogo/sys and gogo/sntp set (platform_esp.c);
#   without HAVE_TIME_DATE mbedTLS would not check validity at all;
CONFIG_MBEDTLS_HAVE_TIME=y
CONFIG_MBEDTLS_HAVE_TIME_DATE=y
# - built for speed (-O2), not size: the handshake's ECC is software on the
#   S3 (the MPI unit helps the big multiplications only); measured on the
#   StickS3 against example.com: ECDHE X25519 260 -> 204 ms, the chain
#   checks 2.3 -> 1.75 s, for +28 KB of flash;
CONFIG_MBEDTLS_COMPILER_OPTIMIZATION_PERF=y
# - sliced ECDSA checks (ServerKeyExchange and the chain);
CONFIG_MBEDTLS_ECP_RESTARTABLE=y
# - TLS 1.2 client only, no renegotiation, no RSA key exchange
#   (tls.c offers ECDHE AEAD suites only);
CONFIG_MBEDTLS_SSL_PROTO_TLS1_2=y
CONFIG_MBEDTLS_SSL_PROTO_TLS1_3=n
CONFIG_MBEDTLS_TLS_CLIENT_ONLY=y
CONFIG_MBEDTLS_SSL_RENEGOTIATION=n
CONFIG_MBEDTLS_KEY_EXCHANGE_RSA=n
# - record buffers 16 KB in (servers do not negotiate smaller) and 4 KB out;
#   fixed: IDF's dynamic buffers reallocate the output buffer, which the
#   port sends from in place until TCP has it acknowledged;
CONFIG_MBEDTLS_ASYMMETRIC_CONTENT_LEN=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
CONFIG_MBEDTLS_DYNAMIC_BUFFER=n
# - X25519 (tls.c prefers it: the unsliced ECDHE step);
CONFIG_MBEDTLS_ECP_DP_CURVE25519_ENABLED=y
# - trust anchors: the certificate bundle in flash. Cross-signed
#   verification off: it verifies through a CA callback, and mbedTLS's
#   chain check with a CA callback is not restartable (the whole chain would
#   be one slice); with it off the chain is checked restartably and only the
#   top certificate's signature against the bundle root is one step.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=n
