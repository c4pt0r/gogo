CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
# Console (and stdout/stderr) on the built-in USB-Serial/JTAG port.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# 1 ms ticks so platform_wait timeouts have millisecond resolution.
CONFIG_FREERTOS_HZ=1000
# Keep the serial console to gogo's own output.
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
# The VM task runs on CPU1 and may keep it busy for long stretches.
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n
# Task notification index 1: console bring-up handshake (index 0 is the
# VM task's platform_wait).
CONFIG_FREERTOS_TASK_NOTIFICATION_ARRAY_ENTRIES=2
# Bigger caches: the VM (CPU1) and the LCD render task (CPU0) share them.
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
# Wi-Fi (M5): raw frames to gogo's own stack; driver buffers at the
# smallest configuration that works (measured; see README "Wi-Fi").
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=2
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=2
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=2
CONFIG_ESP_WIFI_RX_MGMT_BUF_NUM_DEF=1
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=6
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_NVS_ENABLED=n
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n
# Wi-Fi/lwIP code stays in flash: internal RAM goes to the VM arena.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_LWIP_IRAM_OPTIMIZATION=n
# LittleFS for /flash (main/fs_lfs.c): its raw lfs.h API. No malloc: every
# buffer is static and passed in; lfs.c is built without heap access (see
# CMakeLists.txt). The component's own VFS wrapper (unused) does not compile
# with CONFIG_LITTLEFS_MALLOC_STRATEGY_DISABLE, so that stays at default.
# Asserts off: an LFS_ASSERT on a corrupt partition would abort at every
# boot (a boot loop) instead of returning an error to fs_lfs.c.
CONFIG_LITTLEFS_EXPOSE_RAW_API=y
CONFIG_LITTLEFS_ASSERTS=n
# The I2C master ISR (shared bus, only scheduler-thread synchronous transfers)
# may live in flash: saves ~760 B of IRAM.
CONFIG_I2C_MASTER_ISR_HANDLER_IN_IRAM=n
