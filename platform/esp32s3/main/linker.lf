# Keep the console renderer out of the flash cache: the render task runs on
# CPU0 while the VM runs on CPU1, and both cores share the ESP32-S3's
# instruction and data caches. Rendering from flash evicted the VM's code
# and mmapped image (measured: console on 2.4x slower than off). noflash
# puts the code in IRAM and the read-only data in DRAM.
[mapping:gogo_console]
archive: libmain.a
entries:
    console (noflash)
    font (noflash)
    console_task (noflash)
    lcd_st7789 (noflash)

# Board ports (gogo.h GOGO_BOARD_PORT, runtime/board/board_ports.c): the
# pointers every component lays in .gogo_board_port, kept (no code refers
# to them) and bounded by _gogo_board_ports_start / _end, in link order.
[sections:gogo_board_port]
entries:
    .gogo_board_port

[scheme:gogo_board_port_default]
entries:
    gogo_board_port -> flash_rodata

[mapping:gogo_board_port]
archive: *
entries:
    * (gogo_board_port_default);
        gogo_board_port -> flash_rodata KEEP() SURROUND(gogo_board_ports)
