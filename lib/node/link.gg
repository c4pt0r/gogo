package node

import (
	"gogo/actor"
	"gogo/bytes"
	"gogo/errors"
	"gogo/net"
	"gogo/port"
	"gogo/sys"
)

// A link actor owns one TCP connection to a peer node: it runs the
// handshake, then opens the "node" port and pumps bytes between the two.
//
// Handshake frames (u16 length, little-endian, then the body; the client
// proves the token first):
//
//	S -> C  challenge  0x40, version, Ns (16 bytes)
//	C -> S  hello      0x41, version, Nc (16), HMAC(token, "gogo-node-c" Ns Nc name), name
//	S -> C  welcome    0x42, version, server id (u16), your id (u16),
//	                   HMAC(token, "gogo-node-s" Nc Ns yourID serverID serverName name), server name
//	        or reject  0x43, version; then the server closes
const (
	protoVersion = 1
	hsChallenge  = 0x40
	hsHello      = 0x41
	hsWelcome    = 0x42
	hsReject     = 0x43
	hsMax        = 512 // longest handshake frame

	linkMemory = 40 * 1024 // a link actor's memory limit
	queueMax   = 8 * 1024  // frames waiting for TCP; more are dropped (at most once)
	outMax     = 1400      // frames are packed into Outs of up to this
)

func frameOut(conn actor.PID, body []byte) {
	b := make([]byte, 0, len(body)+2)
	b = append(b, byte(len(body)), byte(len(body)>>8))
	b = append(b, body...)
	actor.Send(conn, port.Out{Data: bytes.FromSlice(b)})
}

func appendBytes(buf []byte, d bytes.Bytes) []byte {
	tmp := make([]byte, d.Len())
	d.CopyTo(tmp)
	return append(buf, tmp...)
}

func u16(b []byte) int { return int(b[0]) | int(b[1])<<8 }

func put16(b []byte, v int) []byte { return append(b, byte(v), byte(v>>8)) }

func nonce() []byte {
	n := make([]byte, 16)
	for i := range n {
		n[i] = byte(sys.Random())
	}
	return n
}

func cat(parts ...[]byte) []byte {
	var out []byte
	for _, p := range parts {
		out = append(out, p...)
	}
	return out
}

func ids(a, b int) []byte { return put16(put16(nil, a), b) }

// waitFor reads conn until it has a whole frame in buf (or deadline, or
// the connection ends, or the node's agent dies): the frame's body and
// the bytes after it.
func waitFor(conn, agent actor.PID, buf []byte, deadline int64) ([]byte, []byte, bool) {
	for {
		if len(buf) >= 2 {
			n := u16(buf)
			if n > hsMax {
				return nil, nil, false
			}
			if len(buf) >= 2+n {
				return buf[2 : 2+n], buf[2+n:], true
			}
		}
		left := int(deadline - actor.Now())
		if left <= 0 {
			return nil, nil, false
		}
		m, ok := actor.ReceiveTimeout(left)
		if !ok {
			return nil, nil, false
		}
		switch e := m.(type) {
		case port.Chunk:
			if e.From == conn {
				buf = appendBytes(buf, e.Data)
			}
		case port.Closed:
			if e.From == conn {
				return nil, nil, false
			}
		case actor.DownMsg:
			if e.From == agent { // the node is gone: no handshake for it
				return nil, nil, false
			}
		case kick:
			return nil, nil, false
		}
	}
}

// waitConnected waits for a dialed connection to come up: errors.OK, or
// why not (the tcp port's reason: Refused, NoRoute, Timeout, ...; Closed
// if the node's agent died meanwhile).
func waitConnected(conn, agent actor.PID, deadline int64) errors.Code {
	for {
		left := int(deadline - actor.Now())
		if left <= 0 {
			return errors.Timeout
		}
		m, ok := actor.ReceiveTimeout(left)
		if !ok {
			return errors.Timeout
		}
		switch e := m.(type) {
		case net.Connected:
			return errors.OK
		case port.Closed:
			if e.From == conn {
				if e.Reason == 0 {
					return errors.Closed
				}
				return errors.Code(e.Reason)
			}
		case actor.DownMsg:
			if e.From == agent {
				return errors.Closed
			}
		case kick:
			return errors.Closed
		}
	}
}

// codeOf is err's code (port.Open's errors are Codes). A driver this VM
// does not have ("tcp", "tcp_listen", "node": NotFound) is Unsupported.
func codeOf(err error) errors.Code {
	switch c := err.(type) {
	case errors.Code:
		if c == errors.NotFound {
			return errors.Unsupported
		}
		return c
	}
	return errors.IO
}

// expire drops the door lookups whose Whereis no longer waits (past its
// deadline), so an answer the port could not deliver costs nothing.
func expire(doors []actor.Request) []actor.Request {
	now := actor.Now()
	var keep []actor.Request
	for _, r := range doors {
		switch d := r.Body.(type) {
		case doorReq:
			if d.Until > now {
				keep = append(keep, r)
			}
		}
	}
	return keep
}

// sessionKey is a link's MAC key, from the token and both nonces: both
// ends compute it after a successful handshake.
func sessionKey(key, ns, nc []byte, clientID, serverID int, serverName, clientName string) bytes.Bytes {
	return bytes.FromSlice(hmac256(key, cat([]byte("gogo-node-k"), ns, nc, ids(clientID, serverID), []byte(serverName), []byte(clientName))))
}

// clientLink is a board's side of a new connection to the server.
func clientLink(e ends, conn actor.PID, token, name string, ms int) {
	fail := linkFail{Err: errors.Refused} // the server said no, or not as it should
	deadline := actor.Now() + int64(ms)
	if c := waitConnected(conn, e.Agent, deadline); c != errors.OK {
		actor.Send(e.Agent, linkFail{Err: c})
		return
	}
	body, rest, ok := waitFor(conn, e.Agent, nil, deadline)
	if !ok || len(body) != 18 || body[0] != hsChallenge || body[1] != protoVersion {
		if actor.Now() >= deadline {
			fail = linkFail{Err: errors.Timeout}
		}
		actor.Send(e.Agent, fail)
		return
	}
	ns := body[2:18]
	nc := nonce()
	key := []byte(token)
	hello := cat([]byte{hsHello, protoVersion}, nc, hmac256(key, cat([]byte("gogo-node-c"), ns, nc, []byte(name))), []byte(name))
	frameOut(conn, hello)
	body, rest, ok = waitFor(conn, e.Agent, rest, deadline)
	if !ok || len(body) < 38 || body[0] != hsWelcome || body[1] != protoVersion {
		if actor.Now() >= deadline {
			fail = linkFail{Err: errors.Timeout}
		}
		actor.Send(e.Agent, fail)
		return
	}
	serverID, selfID := u16(body[2:4]), u16(body[4:6])
	sname := string(body[38:])
	want := hmac256(key, cat([]byte("gogo-node-s"), nc, ns, ids(selfID, serverID), []byte(sname), []byte(name)))
	if !equalMAC(body[6:38], want) {
		actor.Send(e.Agent, fail)
		return
	}
	np, err := port.Open("node", net.NodeLink{Self: selfID, Peer: serverID, Relay: 1, Agent: e.Door, Name: sname,
		Key: sessionKey(key, ns, nc, selfID, serverID, sname, name), Conn: conn})
	if err != nil {
		actor.Send(e.Agent, linkFail{Err: codeOf(err)})
		return
	}
	pump(e, conn, np, rest, sname, serverID, selfID)
}

// reject tells a client no, and closes once that went out.
func reject(conn actor.PID) {
	frameOut(conn, []byte{hsReject, protoVersion})
	actor.Send(conn, net.Shutdown{})
	deadline := actor.Now() + 500
	for {
		left := int(deadline - actor.Now())
		if left <= 0 {
			break
		}
		m, ok := actor.ReceiveTimeout(left)
		if !ok {
			break
		}
		switch d := m.(type) {
		case port.Done:
			if d.From == conn {
				left = 0
			}
		}
		if left == 0 {
			break
		}
	}
	port.Close(conn)
}

// serverLink is the server's side of a board's new connection. It tells
// the listener when its handshake is over, whatever the outcome.
func serverLink(e ends, listener, conn actor.PID, token, name string, ms int) {
	if !serverHandshake(e, listener, conn, token, name, ms) {
		actor.Send(listener, hsDone{Link: actor.Self()})
		reject(conn)
	}
}

// serverHandshake checks the board's proof, opens the node port and only
// then welcomes the board (so a refused open is a reject, not a link that
// drops at once); then it pumps. False: the caller rejects.
func serverHandshake(e ends, listener, conn actor.PID, token, name string, ms int) bool {
	deadline := actor.Now() + int64(ms)
	ns := nonce()
	frameOut(conn, cat([]byte{hsChallenge, protoVersion}, ns))
	body, rest, ok := waitFor(conn, e.Agent, nil, deadline)
	if !ok || len(body) < 51 || body[0] != hsHello || body[1] != protoVersion {
		return false
	}
	nc := body[2:18]
	cname := string(body[50:])
	key := []byte(token)
	if !equalMAC(body[18:50], hmac256(key, cat([]byte("gogo-node-c"), ns, nc, []byte(cname)))) {
		return false
	}
	r, _ := actor.Call(e.Agent, assignReq{Name: cname, Link: actor.Self()}, 2000)
	id, _ := r.(int) // r is nil if the Call failed
	if id == 0 {
		return false
	}
	// The node port sends the welcome itself, first (Hello): it may take
	// the connection over (Conn), and then nothing goes out through conn.
	mac := hmac256(key, cat([]byte("gogo-node-s"), nc, ns, ids(id, 1), []byte(name), []byte(cname)))
	welcome := cat([]byte{hsWelcome, protoVersion}, ids(1, id), mac, []byte(name))
	np, err := port.Open("node", net.NodeLink{Self: 1, Peer: id, Relay: 0, Agent: e.Door, Name: cname,
		Key: sessionKey(key, ns, nc, id, 1, name, cname), Conn: conn,
		Hello: bytes.FromSlice(cat(put16(nil, len(welcome)), welcome))})
	if err != nil {
		return false
	}
	actor.Send(listener, hsDone{Link: actor.Self()})
	pump(e, conn, np, rest, cname, id, 1)
	return true
}

// flush hands queued frames to TCP, packed into Outs of up to outMax
// bytes, while fewer than two Outs are in flight.
func flush(conn actor.PID, q []bytes.Bytes, qb, inflight int) ([]bytes.Bytes, int, int) {
	for inflight < 2 && len(q) > 0 {
		n, size := 0, 0
		for n < len(q) && (n == 0 || size+q[n].Len() <= outMax) {
			size += q[n].Len()
			n++
		}
		data := q[0]
		if n > 1 {
			b := bytes.NewBuffer(size)
			for i := 0; i < n; i++ {
				b.WriteBytes(q[i])
			}
			data = b.Freeze()
		}
		actor.Send(conn, port.Out{Data: data})
		inflight++
		qb -= size
		q = q[n:]
	}
	return q, qb, inflight
}

// pump moves bytes between the TCP connection and the node port until
// either ends (or the agent kicks it): the peer's bytes go to the port,
// the port's frames to TCP. Closing the node port fires the remote
// monitors and links; the agent sees this actor's exit.
func pump(e ends, conn, np actor.PID, rest []byte, peerName string, peerID, selfID int) {
	if len(rest) > 0 {
		actor.Send(np, port.Out{Data: bytes.FromSlice(rest)})
	}
	var q []bytes.Bytes
	var doors []actor.Request // Whereis lookups waiting for a door (doorReq)
	qb, inflight := 0, 0
	for {
		switch m := actor.Receive().(type) {
		case actor.Request:
			switch d := m.Body.(type) {
			case doorReq:
				doors = expire(doors) // a lost answer leaves nothing behind
				if len(doors) < 64 {  // more wait for their timeout
					doors = append(doors, m)
					actor.Send(np, net.NodeEvent{Kind: net.NodeDoor, Node: d.ID})
				}
			}
		case port.Chunk:
			if m.From == conn {
				actor.Send(np, port.Out{Data: m.Data})
			} else if m.From == np {
				if qb+m.Data.Len() <= queueMax {
					q = append(q, m.Data)
					qb += m.Data.Len()
				}
				q, qb, inflight = flush(conn, q, qb, inflight)
			}
		case port.Done:
			if m.From == conn {
				inflight--
				q, qb, inflight = flush(conn, q, qb, inflight)
			}
		case port.Closed:
			if m.From == conn || m.From == np {
				port.Close(np)
				port.Close(conn)
				return
			}
		case net.NodeEvent:
			if m.Kind == net.NodeUp && m.Node == peerID {
				actor.Send(e.Agent, linkUp{Name: peerName, ID: peerID, Self: selfID, Link: actor.Self()})
			} else if m.Kind == net.NodeUp {
				actor.Send(e.Agent, nodeUp{Name: m.Name, ID: m.Node})
			} else if m.Kind == net.NodeDoor {
				// The door asked for: answer every Whereis waiting for it.
				var keep []actor.Request
				for _, r := range doors {
					want := 0
					switch d := r.Body.(type) {
					case doorReq:
						want = d.ID
					}
					if want == m.Node {
						actor.Reply(r, m.Agent)
					} else {
						keep = append(keep, r)
					}
				}
				doors = keep
			} else if m.Kind == net.NodeDown {
				actor.Send(e.Agent, nodeGone{ID: m.Node})
			} else if m.Kind == net.NodeCarried {
				// The node port took conn over; conn's Chunks queued before
				// this event were forwarded: it may read the socket now.
				actor.Send(np, net.Resume{})
			}
		case kick:
			port.Close(np)
			port.Close(conn)
			return
		case actor.DownMsg:
			if m.From == e.Agent { // the node's agent died: the node is gone
				port.Close(np)
				port.Close(conn)
				return
			}
		}
	}
}
