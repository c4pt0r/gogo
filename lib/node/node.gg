// Package node makes a VM a node of a star of distributed actors (import
// path gogo/node): boards connect to one server node, which relays
// board-to-board messages. A remote actor's PID is an ordinary actor.PID:
// actor.Send, Call, Reply, Monitor, Link and == work on it as on a local
// one (docs/design.md §5.13, the book's chapter 20).
//
//	err := node.Listen(4370, "server")           // on the host: gogovm --host-net
//	err := node.Connect("192.168.1.10:4370", "cardputer")   // on a board
//	err := node.Register("autopilot", actor.Self())         // reachable by name
//	pid, err := node.Whereis("server", "autopilot", 2000)
//
// Both ends need the same shared token: the config key node.token (or
// Options.Token). A node without one refuses to listen or connect. The
// handshake is a challenge-response with HMAC-SHA-256 over plain TCP, and
// every frame then carries a MAC under a session key; the traffic itself
// is not encrypted (see the book on security).
//
// What crosses: ints, int64, bool, string, bytes.Bytes, []byte, slices,
// nil, actor PIDs, Refs, the reserved structs (actor.Request, ...) and a
// module's own structs, matched by qualified name ("snake/board.View"),
// field count and field kinds in the receiving program (a struct the
// receiver does not have is dropped there). A closure, a bytes.Buffer, a
// pointer or map, a port's PID, nesting deeper than 16 or more than 4 KB
// of encoding crashes the sender with actor.BadMsg. Delivery is at most
// once and in order between two actors; when a node becomes unreachable,
// monitors of its actors get a DownMsg with reason actor.NoConnection,
// links an exit signal with it, and Calls to it fail at once.
//
// A peer reaches a node's door (its zero PID), which only answers
// Whereis for names exported with Register, and the PIDs the node gave
// out in messages; never the agent that keeps the names.
//
// Drivers: "tcp", "tcp_listen" and "node", opened without requiring them,
// so a program that only may join a node runs on a firmware without
// networking (Listen and Connect then return errors.Unsupported).
//
//gogo:optional tcp tcp_listen node
package node

// Compiled into an image only for the functions the program uses
// (//gogo:ondemand), like the rest of gogo/node: its calls go through
// actor.Call and actor.Register (image format 15.7).
//
//gogo:ondemand

import (
	"gogo/actor"
	"gogo/errors"
	"gogo/net"
	"gogo/port"
	"gogo/strconv"
	"gogo/strings"
	"gogo/sys"
)

// DefaultPort is the server node's usual TCP port.
const DefaultPort = 4370

// Options configures Listen and Connect.
type Options struct {
	Name      string // this node's name ("": the config key node.name)
	Token     string // the shared secret ("": the config key node.token)
	TimeoutMs int    // Connect: dial and handshake (0: 5000)
}

// Up is sent to subscribers when a node joins (Subscribe).
type Up struct{ Node string }

// Down is sent to subscribers when a node is gone (Subscribe).
type Down struct{ Node string }

// The agent's requests (local Calls).
type listenReq struct {
	Port int
	Opts Options
}
type connectReq struct {
	IP, Port int
	Opts     Options
}
type registerReq struct {
	Name string
	PID  actor.PID
}
type unregisterReq struct{ Name string }
type peerReq struct{ Node, Name string }
type peerAns struct {
	Local bool      // PID is the local actor of the name
	PID   actor.PID // else the link actor that reaches node ID (doorReq)
	ID    int
	Err   errors.Code
}

// From Whereis to a link actor: node ID's door (a remote PID made on
// demand, so a board in a big star holds proxies only for the nodes it
// talks to), or the zero PID if the node cannot be reached.
// Until is the Whereis's deadline (actor.Now): past it nobody waits, and
// the link actor forgets the request even if no answer came.
type doorReq struct {
	ID    int
	Until int64
}
type nodesReq struct{}
type selfReq struct{}
type subscribeReq struct{ PID actor.PID }
type disconnectReq struct{}

// Between nodes: the one request a node's door answers.
type whereisReq struct{ Name string }

// From the door to the agent (local only).
type lookupReq struct{ Name string }

// From a link actor to the agent: the server reported another board.
type nodeUp struct {
	Name string
	ID   int
}

// From link actors to the agent.
type linkUp struct {
	Name string // the peer's name
	ID   int    // the peer's id
	Self int    // this node's id
	Link actor.PID
}
type linkFail struct{ Err errors.Code }
type assignReq struct {
	Name string
	Link actor.PID
}
type nodeGone struct{ ID int }

// peer is a node the agent knows.
type peer struct {
	Name string
	ID   int
	Link actor.PID // the local link actor to it (monitored), or the zero PID (through the relay)
}

// agentMemory is the agent's memory limit: its state grows with the nodes
// it knows (a server: one entry per board, up to the link cap; a board:
// every node of the star), so gogovm derives it from the link cap and
// vm.actor_memory and answers it as sys.Config's "node.agent_memory"
// (runtime/board/params.h): 1 MB on a host VM with the default 512 links,
// about 720 KB more for 2047. At least 256 KB, a board's ceiling, which it
// always is there (a VM that does not answer, a board or an older gogovm,
// gives that). A server refuses new
// boards once the agent uses three quarters of it.
func agentMemory() int {
	m := 256 * 1024
	if v, ok := sys.Config("node.agent_memory"); ok {
		if n, err := strconv.Atoi(v); err == nil && n > m {
			m = n
		}
	}
	return m
}

// agent returns the node agent, starting it on first use.
func agent() actor.PID {
	if p, ok := actor.Whereis("node"); ok {
		return p
	}
	// Its limit (agentMemory) follows the link cap; a board's arena
	// bounds it first. tests/dist fills a server to its link cap.
	mem := agentMemory()
	p := actor.SpawnOpt(func() { agentRun(mem / 4 * 3) }, actor.Options{MaxMemory: mem})
	if actor.Register("node", p) == nil {
		return p
	}
	actor.Kill(p, actor.Killed) // another actor started one first
	q, _ := actor.Whereis("node")
	return q
}

func call(req any, ms int) (any, error) { return actor.Call(agent(), req, ms) }

// Listen makes this VM the server node name, accepting boards on TCP port.
// The token is the config key node.token. The errors (gogo/errors):
// BadArg without a token or a name, Busy if this VM is a node already,
// and port.Open's for the listening port (Unsupported without a host
// network, Busy if the port is taken). Like every call here it asks this
// VM's node agent with actor.Call, so it can also fail with that Call's
// error: Timeout if the agent does not answer in time, NoProc if the
// agent died just then.
func Listen(port int, name string) error { return ListenOpt(port, Options{Name: name}) }

// ListenOpt is Listen with Options (TimeoutMs bounds each handshake).
func ListenOpt(port int, opts Options) error {
	return asError(call(listenReq{Port: port, Opts: opts}, 5000))
}

// Connect makes this VM the node name of the server at addr ("a.b.c.d:port";
// the port defaults to DefaultPort). It returns once the handshake is done,
// or the error (gogo/errors): BadArg without a token or a name or for a
// bad addr, Busy if the server is at its handshake limit (it answered
// busy, or closed before its challenge) or this VM is a node already,
// Unsupported without a network, the tcp port's reason if the server
// cannot be reached (Refused, NoRoute, Timeout, ...), Refused if the
// server rejects the handshake (another token, or it is full), Timeout if
// it does not finish in time (or the agent does not answer), NoProc if
// the node agent died meanwhile. It makes one attempt: a board retries
// with backoff and jitter (the book, 20.3), since many boards starting
// together find the server busy and a board may boot before its server.
// If the connection is lost later, Down events say so (Subscribe);
// Connect again to rejoin.
func Connect(addr, name string) error { return ConnectOpt(addr, Options{Name: name}) }

// ConnectOpt is Connect with Options.
func ConnectOpt(addr string, opts Options) error {
	ip, p, ok := parseAddr(addr)
	if !ok {
		return errors.BadArg
	}
	ms := opts.TimeoutMs
	if ms <= 0 {
		ms = 5000
	}
	return asError(call(connectReq{IP: ip, Port: p, Opts: Options{Name: opts.Name, Token: opts.Token, TimeoutMs: ms}}, ms+1000))
}

// Disconnect drops this board's link to the server (a server keeps
// listening). Its remote monitors and links fire with NoConnection.
func Disconnect() { call(disconnectReq{}, 2000) }

// Register makes p reachable from other nodes as name (node.Whereis);
// errors.Exists if the name is taken, or the agent Call's error
// (Timeout, NoProc if the node agent died). actor.Register names stay
// local.
func Register(name string, p actor.PID) error {
	return asError(call(registerReq{Name: name, PID: p}, 2000))
}

// Unregister removes a name Register made.
func Unregister(name string) { call(unregisterReq{Name: name}, 2000) }

// Whereis finds the actor registered as name on node (this node's own name
// included), waiting at most timeoutMs for the answer. The errors
// (gogo/errors): Closed if this VM is not a node, NotFound if the node or
// the name is not known, Timeout if the answer did not come in time,
// NoConnection if the node went away during the lookup. Unlike
// actor.Whereis, a local table lookup, it asks another node over the
// network, so it can fail for reasons the network has.
func Whereis(node, name string, timeoutMs int) (actor.PID, error) {
	deadline := actor.Now() + int64(timeoutMs) // the whole lookup, all its steps
	r, err := call(peerReq{Node: node, Name: name}, timeoutMs)
	if err != nil {
		return actor.NoPID, err
	}
	a, ok := r.(peerAns)
	if !ok {
		return actor.NoPID, errors.Timeout
	}
	if a.Err != errors.OK {
		return actor.NoPID, a.Err
	}
	if a.Local {
		return a.PID, nil
	}
	left := int(deadline - actor.Now())
	if left <= 0 {
		return actor.NoPID, errors.Timeout
	}
	d, err := actor.Call(a.PID, doorReq{ID: a.ID, Until: deadline}, left)
	if err != nil {
		return actor.NoPID, err // Timeout, or NoConnection: the node went away
	}
	door, _ := d.(actor.PID)
	if door == actor.NoPID {
		return actor.NoPID, errors.NotFound // gone meanwhile
	}
	left = int(deadline - actor.Now())
	if left <= 0 {
		return actor.NoPID, errors.Timeout
	}
	r2, err := actor.Call(door, whereisReq{Name: name}, left)
	if err != nil {
		return actor.NoPID, err
	}
	p, _ := r2.(actor.PID)
	if p == actor.NoPID {
		return actor.NoPID, errors.NotFound
	}
	return p, nil
}

// Nodes lists the nodes this one can reach (itself not included).
func Nodes() []string {
	r, _ := call(nodesReq{}, 2000)
	switch l := r.(type) {
	case nodeList:
		return l.Names
	}
	return nil
}

type nodeList struct{ Names []string }

// Self is this node's name ("" before Listen or Connect).
func Self() string {
	r, _ := call(selfReq{}, 2000)
	switch s := r.(type) {
	case string:
		return s
	}
	return ""
}

// Subscribe makes the caller receive Up and Down for every node that joins
// or goes (until it exits).
func Subscribe() { call(subscribeReq{PID: actor.Self()}, 2000) }

// asError is the agent's answer (an errors.Code) as an error: nil for OK,
// the Call's error if it did not answer.
func asError(r any, err error) error {
	if err != nil {
		return err
	}
	c, ok := r.(errors.Code)
	if !ok {
		return errors.Timeout
	}
	if c == errors.OK {
		return nil
	}
	return c
}

// canStart is why Listen or Connect cannot start (errors.OK if it can).
func canStart(selfID int, waiting bool, o Options) errors.Code {
	if o.Token == "" || o.Name == "" {
		return errors.BadArg
	}
	if selfID != 0 || waiting {
		return errors.Busy
	}
	return errors.OK
}

// parseAddr reads "a.b.c.d[:port]".
func parseAddr(s string) (int, int, bool) {
	host, ps, hasPort := strings.Cut(s, ":")
	p := DefaultPort
	if hasPort {
		n, err := strconv.Atoi(ps)
		if err != nil || n <= 0 || n > 65535 {
			return 0, 0, false
		}
		p = n
	}
	if host == "localhost" {
		return 127<<24 | 1, p, true
	}
	parts := strings.Split(host, ".")
	if len(parts) != 4 {
		return 0, 0, false
	}
	ip := 0
	for _, x := range parts {
		n, err := strconv.Atoi(x)
		if err != nil || n < 0 || n > 255 {
			return 0, 0, false
		}
		ip = ip<<8 | n
	}
	return ip, p, true
}

// configured fills a missing name or token from the config store.
func configured(o Options) Options {
	name, token := o.Name, o.Token
	if name == "" {
		name, _ = sys.Config("node.name")
	}
	if token == "" {
		token, _ = sys.Config("node.token")
	}
	return Options{Name: name, Token: token, TimeoutMs: o.TimeoutMs}
}

// ---- the agent and the door ----
//
// Two actors per node. The agent (registered locally as "node") holds
// the node table, the exported names and the subscribers, and serves the
// calls of this package; its PID never leaves the node, so no peer can
// reach it. The door is the actor a peer reaches at a node's zero PID
// (NodeLink.Agent): it answers whereisReq only, asking the agent, and
// ignores everything else. Node news comes from the links (net.NodeEvent,
// made by the node port in C), not from peers' messages.

func notify(subs []actor.PID, msg any) {
	for _, s := range subs {
		actor.Send(s, msg)
	}
}

// (In place: the last entry takes i's place; the order does not matter.)
func without(ps []peer, i int) []peer {
	last := len(ps) - 1
	ps[i] = ps[last]
	return ps[:last]
}

// doorRun answers peers' whereisReq Calls for the names exported here.
func doorRun(agentPID actor.PID) {
	actor.TrapExit(true) // a link signal must not end it
	actor.Monitor(agentPID)
	for {
		switch m := actor.Receive().(type) {
		case actor.DownMsg:
			if m.From == agentPID { // the node is gone: a new one has its own door
				return
			}
		case actor.Request:
			switch r := m.Body.(type) {
			case whereisReq:
				v, _ := actor.Call(agentPID, lookupReq{Name: r.Name}, 1000)
				pid, _ := v.(actor.PID) // the zero PID if the Call failed
				actor.Reply(m, pid)
			}
		}
	}
}

// agentRun is the node agent; see above. full is the memory use past which
// it refuses new boards.
func agentRun(full int) {
	var zero actor.PID
	self := actor.Self()
	// The link actors and the listener monitor the agent (a monitor is
	// charged to its watcher; a link would charge the agent a reserved
	// exit note per board): if it dies they end, their ports close, and
	// the node is gone (remote PIDs report NoConnection); the next Listen
	// or Connect starts a new agent.
	door := actor.Spawn(func() { doorRun(self) })
	doorRef := actor.Monitor(door)
	name := ""
	selfID, nextID := 0, 2
	server := false
	ms := 5000
	var peers []peer
	var relay actor.PID // a board: its link actor to the server
	var names []string
	var namePIDs []actor.PID
	var subs []actor.PID
	var pending actor.Request // a Connect waiting for its link
	waiting := false
	for {
		switch m := actor.Receive().(type) {
		case actor.Request:
			switch r := m.Body.(type) {
			case listenReq:
				o := configured(r.Opts)
				if c := canStart(selfID, waiting, o); c != errors.OK {
					actor.Reply(m, c)
					break
				}
				if o.TimeoutMs > 0 {
					ms = o.TimeoutMs
				}
				if c := startListener(ends{Agent: self, Door: door}, r.Port, o.Token, o.Name, ms); c != errors.OK {
					actor.Reply(m, c)
					break
				}
				name, selfID, server = o.Name, 1, true
				actor.Reply(m, errors.OK)
			case connectReq:
				o := configured(r.Opts)
				if c := canStart(selfID, waiting, o); c != errors.OK {
					actor.Reply(m, c)
					break
				}
				name = o.Name
				startDial(ends{Agent: self, Door: door}, r.IP, r.Port, o.Token, o.Name, o.TimeoutMs)
				pending, waiting = m, true
			case disconnectReq:
				for _, p := range peers {
					if p.Link != zero {
						actor.Send(p.Link, kick{})
					}
				}
				actor.Reply(m, true)
			case registerReq:
				c := errors.OK
				for _, n := range names {
					if n == r.Name {
						c = errors.Exists
					}
				}
				if c == errors.OK {
					names = append(names, r.Name)
					namePIDs = append(namePIDs, r.PID)
				}
				actor.Reply(m, c)
			case unregisterReq:
				var n2 []string
				var p2 []actor.PID
				for i, n := range names {
					if n != r.Name {
						n2 = append(n2, n)
						p2 = append(p2, namePIDs[i])
					}
				}
				names, namePIDs = n2, p2
				actor.Reply(m, true)
			case lookupReq: // from the door
				pid := zero
				for i, n := range names {
					if n == r.Name {
						pid = namePIDs[i]
					}
				}
				actor.Reply(m, pid)
			case peerReq:
				ans := peerAns{Err: errors.NotFound}
				if selfID == 0 {
					ans.Err = errors.Closed // not a node
				} else if r.Node == name {
					for i, n := range names {
						if n == r.Name {
							ans = peerAns{Local: true, PID: namePIDs[i]}
						}
					}
				} else {
					for _, p := range peers {
						if p.Name == r.Node {
							via := p.Link // a board reaches every node through its server link
							if via == zero {
								via = relay
							}
							ans = peerAns{PID: via, ID: p.ID}
						}
					}
				}
				actor.Reply(m, ans)
			case nodesReq:
				var l []string
				for _, p := range peers {
					l = append(l, p.Name)
				}
				actor.Reply(m, nodeList{Names: l})
			case selfReq:
				if selfID == 0 {
					actor.Reply(m, "")
				} else {
					actor.Reply(m, name)
				}
			case subscribeReq:
				subs = append(subs, r.PID)
				actor.Monitor(r.PID)
				actor.Reply(m, true)
			case assignReq: // server: a board passed the handshake
				// Refused rather than die: past this much state the next
				// growth of the agent's heap could pass its limit.
				if r.Name == name || actor.Info(self).Memory > full {
					actor.Reply(m, 0)
					break
				}
				// The next id no live board has (ids wrap after 65535).
				id := 0
				for k := 0; k < 65534 && id == 0; k++ {
					c := nextID
					nextID++
					if nextID > 65535 {
						nextID = 2
					}
					inUse := false
					for _, p := range peers {
						if p.ID == c {
							inUse = true
						}
					}
					if !inUse {
						id = c
					}
				}
				actor.Reply(m, id)
			}
		case linkUp:
			if !server {
				selfID = m.Self
			}
			// A board of that name already here (it rebooted): its old link
			// goes, now that the new one is open.
			for i, p := range peers {
				if server && p.Name == m.Name && p.Link != zero {
					actor.Send(p.Link, kick{})
					peers = without(peers, i)
					notify(subs, Down{Node: p.Name})
					break
				}
			}
			actor.Monitor(m.Link) // its DownMsg comes From m.Link
			peers = append(peers, peer{Name: m.Name, ID: m.ID, Link: m.Link})
			if !server {
				relay = m.Link
			}
			notify(subs, Up{Node: m.Name})
			if waiting {
				actor.Reply(pending, errors.OK)
				waiting = false
			}
		case linkFail:
			if waiting {
				actor.Reply(pending, m.Err)
				waiting = false
				name = ""
			}
		case nodeUp: // a board: the server reported another board
			known := m.ID == selfID
			for _, p := range peers {
				if p.ID == m.ID {
					known = true
				}
			}
			if !server && !known {
				peers = append(peers, peer{Name: m.Name, ID: m.ID})
				notify(subs, Up{Node: m.Name})
			}
		case nodeGone: // the server reported a node gone
			for i, p := range peers {
				if p.ID == m.ID && p.Link == zero {
					peers = without(peers, i)
					notify(subs, Down{Node: p.Name})
					break
				}
			}
		case actor.DownMsg:
			if m.Ref == doorRef { // a bug if ever (it traps exits): a door for later Listens and Connects
				door = actor.Spawn(func() { doorRun(self) })
				doorRef = actor.Monitor(door)
				break
			}
			// A link actor ended: its peer, and on a board every node, is gone.
			lost := -1
			for i, p := range peers {
				if p.Link == m.From && p.Link != zero {
					lost = i
				}
			}
			if lost >= 0 && server {
				notify(subs, Down{Node: peers[lost].Name})
				peers = without(peers, lost)
				break
			}
			if lost >= 0 {
				for _, p := range peers {
					notify(subs, Down{Node: p.Name})
				}
				peers = nil
				selfID = 0
				name = ""
				break
			}
			var s2 []actor.PID // a subscriber exited
			for _, s := range subs {
				if s != m.From {
					s2 = append(s2, s)
				}
			}
			subs = s2
		}
	}
}

// ---- dialing and listening ----

// kick asks a link actor to drop its connection.
type kick struct{}

// ends are the local actors a link actor works for: the agent (its
// reports) and the door (the node port's Agent).
type ends struct {
	Agent, Door actor.PID
}

// startDial starts a board's link actor, which reports linkUp or linkFail
// to the agent.
func startDial(e ends, ip, p int, token, name string, ms int) {
	actor.SpawnOpt(func() {
		actor.Monitor(e.Agent) // it ends with the agent (pump; its ports close)
		conn, err := port.Open("tcp", net.Dial{IP: ip, Port: p, TimeoutMs: ms})
		if err != nil {
			actor.Send(e.Agent, linkFail{Err: codeOf(err)})
			return
		}
		clientLink(e, conn, token, name, ms)
	}, actor.Options{MaxMemory: linkMemory})
}

// hsDone tells the listener that a link actor's handshake ended.
type hsDone struct{ Link actor.PID }

// handshakeSlots is how many connections the listener takes into their
// handshake at once: the link cap L / 32, at least 2 and at most 64 (2 on
// a board, L = 8; 16 on a host, L = 512; 64 at the ceiling, L = 2048).
// More are refused at once, busy (refuse), so that a crowd of boards
// starting together (a server with hundreds of boards after a power cut)
// joins at a rate the slots allow, each board retrying with backoff, and
// an unauthenticated peer cannot hold more than a fixed share:
//   - time: a slot is held until its handshake ends, or its timeout
//     (Options.TimeoutMs, 5 s); a legitimate handshake takes a round trip
//     and two HMACs, a few ms on a LAN, so 16 slots admit hundreds of
//     boards a second;
//   - memory: one link actor per slot (at most linkMemory, 40 KB: 640 KB
//     for 16 on a host); a refusal spawns nothing;
//   - ports: one tcp port per slot, and one per refusal still sending its
//     busy frame (at most as many again, each for at most refuseMs; past
//     that a connection is closed outright): 2 * 16 + 1 (the listener) + L
//     links (the node port took each link's connection over) fit the
//     host's 1024 ports. A board's 16 ports are its 8 links already (two
//     ports per link without a carrier), so a board server keeps 2.
//
// The link cap is the platform's "\x00links" (gogovm: --max-links, else
// node.max_links, else 512), else node.max_links, else 8 (a board's
// default), as the node port's own tables are sized (runtime/dist).
func handshakeSlots() int {
	n := linkCap() / 32
	if n < 2 {
		n = 2
	}
	if n > 64 {
		n = 64
	}
	return n
}

// linkCap is this VM's cap on node links (see handshakeSlots).
func linkCap() int {
	for _, k := range []string{"\x00links", "node.max_links"} {
		if v, ok := sys.Config(k); ok {
			if n, err := strconv.Atoi(v); err == nil && n > 0 {
				return n
			}
		}
	}
	return 8
}

// refuseMs bounds how long a refused connection may take to send its busy
// frame before it is closed anyway.
const refuseMs = 500

// refuseEnd: a refused connection's time is up.
type refuseEnd struct{ Conn actor.PID }

// refuse tells a board the server is busy (hsBusy), then shuts the
// connection down: the listener closes it on its Done (the frame went
// out, before the FIN), its Closed, or refuseMs later.
func refuse(conn, me actor.PID) actor.Ref {
	frameOut(conn, []byte{hsBusy, protoVersion})
	actor.Send(conn, net.Shutdown{})
	return actor.SendAfter(me, refuseEnd{Conn: conn}, refuseMs)
}

// refused closes the refused connection c, if it is one, and drops it.
func refused(cs []actor.PID, ts []actor.Ref, c actor.PID) ([]actor.PID, []actor.Ref) {
	var c2 []actor.PID
	var t2 []actor.Ref
	for i, x := range cs {
		if x == c {
			port.Close(x)
			actor.CancelTimer(ts[i])
		} else {
			c2 = append(c2, x)
			t2 = append(t2, ts[i])
		}
	}
	return c2, t2
}

// forget drops the link actor w, or the one monitored by r, from the
// handshakes in progress.
func forget(ws []actor.PID, rs []actor.Ref, w actor.PID, r actor.Ref) ([]actor.PID, []actor.Ref) {
	var w2 []actor.PID
	var r2 []actor.Ref
	for i, x := range ws {
		if x == w || rs[i] == r {
			actor.Demonitor(rs[i])
		} else {
			w2 = append(w2, x)
			r2 = append(r2, rs[i])
		}
	}
	return w2, r2
}

// startListener opens the listening port and hands it to a listener
// actor, which hands every connection to a new server link actor.
func startListener(e ends, p int, token, name string, ms int) errors.Code {
	lp, err := port.Open("tcp_listen", net.Listen{Port: p})
	if err != nil {
		return codeOf(err)
	}
	l := actor.Spawn(func() {
		actor.Monitor(e.Agent) // it ends with the agent, its port closing
		me := actor.Self()
		var shaking []actor.PID // the link actors in their handshake
		var refs []actor.Ref    // and the listener's monitors on them
		var busy []actor.PID    // refused connections sending their busy frame
		var timers []actor.Ref  // and their refuseEnd timers
		slots := handshakeSlots()
		for {
			switch m := actor.Receive().(type) {
			case net.Accepted:
				conn := m.Conn
				if len(shaking) >= slots {
					if len(busy) < slots {
						busy = append(busy, conn)
						timers = append(timers, refuse(conn, me))
					} else {
						port.Close(conn) // a reset: the board's Connect says Busy all the same
					}
					break
				}
				w := actor.SpawnOpt(func() {
					actor.Monitor(e.Agent) // it ends with the agent (pump), its ports closing
					serverLink(e, me, conn, token, name, ms)
				}, actor.Options{MaxMemory: linkMemory})
				if !port.Handoff(conn, w) {
					port.Close(conn)
					actor.Kill(w, actor.Killed)
					break
				}
				shaking = append(shaking, w)
				refs = append(refs, actor.Monitor(w))
			case port.Done: // a busy frame went out
				busy, timers = refused(busy, timers, m.From)
			case port.Closed:
				busy, timers = refused(busy, timers, m.From)
			case refuseEnd:
				busy, timers = refused(busy, timers, m.Conn)
			case hsDone: // a handshake ended: it no longer counts
				var zr actor.Ref
				shaking, refs = forget(shaking, refs, m.Link, zr)
			case actor.DownMsg:
				if m.From == e.Agent { // the node is gone: so is its listener (and port)
					return
				}
				var zw actor.PID // a link actor ended during its handshake
				shaking, refs = forget(shaking, refs, zw, m.Ref)
			}
		}
	})
	if !port.Handoff(lp, l) {
		port.Close(lp)
		actor.Kill(l, actor.Killed)
		return errors.Busy
	}
	return errors.OK
}
