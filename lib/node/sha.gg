package node

// Compiled into an image only for the functions the program uses
// (//gogo:ondemand), like the rest of gogo/node: its calls go through
// actor.Call and actor.Register (image format 15.7).
//
//gogo:ondemand

// SHA-256 and HMAC-SHA-256 (FIPS 180-4, RFC 2104) for the handshake, on
// gogo's 32-bit wrapping ints: x >> n is arithmetic, so a logical shift
// masks the sign bits away.

// shr is x >> n without the sign bits (1 <= n <= 31).
func shr(x, n int) int { return (x >> n) & ((1 << (32 - n)) - 1) }

func rotr(x, n int) int { return shr(x, n) | x<<(32-n) }

// sha256K returns the round constants (signed: those from 2^31 up are
// negative).
func sha256K() []int {
	return []int{
		1116352408, 1899447441, -1245643825, -373957723, 961987163, 1508970993, -1841331548, -1424204075,
		-670586216, 310598401, 607225278, 1426881987, 1925078388, -2132889090, -1680079193, -1046744716,
		-459576895, -272742522, 264347078, 604807628, 770255983, 1249150122, 1555081692, 1996064986,
		-1740746414, -1473132947, -1341970488, -1084653625, -958395405, -710438585, 113926993, 338241895,
		666307205, 773529912, 1294757372, 1396182291, 1695183700, 1986661051, -2117940946, -1838011259,
		-1564481375, -1474664885, -1035236496, -949202525, -778901479, -694614492, -200395387, 275423344,
		430227734, 506948616, 659060556, 883997877, 958139571, 1322822218, 1537002063, 1747873779,
		1955562222, 2024104815, -2067236844, -1933114872, -1866530822, -1538233109, -1090935817, -965641998,
	}
}

// sum256 is the SHA-256 digest of msg (32 bytes).
func sum256(msg []byte) []byte {
	h := []int{1779033703, -1150833019, 1013904242, -1521486534, 1359893119, -1694144372, 528734635, 1541459225}
	k := sha256K()
	p := make([]byte, 0, len(msg)+72)
	p = append(p, msg...)
	p = append(p, 0x80)
	for len(p)%64 != 56 {
		p = append(p, 0)
	}
	bits := len(msg) * 8
	p = append(p, 0, 0, 0, byte(shr(bits, 29)), byte(bits>>24), byte(bits>>16), byte(bits>>8), byte(bits))
	w := make([]int, 64)
	for off := 0; off < len(p); off += 64 {
		for i := 0; i < 16; i++ {
			j := off + 4*i
			w[i] = int(p[j])<<24 | int(p[j+1])<<16 | int(p[j+2])<<8 | int(p[j+3])
		}
		for i := 16; i < 64; i++ {
			s0 := rotr(w[i-15], 7) ^ rotr(w[i-15], 18) ^ shr(w[i-15], 3)
			s1 := rotr(w[i-2], 17) ^ rotr(w[i-2], 19) ^ shr(w[i-2], 10)
			w[i] = w[i-16] + s0 + w[i-7] + s1
		}
		a, b, c, d, e, f, g, hh := h[0], h[1], h[2], h[3], h[4], h[5], h[6], h[7]
		for i := 0; i < 64; i++ {
			t1 := hh + (rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25)) + (e&f ^ ^e&g) + k[i] + w[i]
			t2 := (rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22)) + (a&b ^ a&c ^ b&c)
			hh, g, f, e, d, c, b, a = g, f, e, d+t1, c, b, a, t1+t2
		}
		h[0] += a
		h[1] += b
		h[2] += c
		h[3] += d
		h[4] += e
		h[5] += f
		h[6] += g
		h[7] += hh
	}
	out := make([]byte, 32)
	for i := 0; i < 8; i++ {
		out[4*i] = byte(h[i] >> 24)
		out[4*i+1] = byte(h[i] >> 16)
		out[4*i+2] = byte(h[i] >> 8)
		out[4*i+3] = byte(h[i])
	}
	return out
}

// hmac256 is HMAC-SHA-256 of msg under key.
func hmac256(key, msg []byte) []byte {
	if len(key) > 64 {
		key = sum256(key)
	}
	in := make([]byte, 64, 64+len(msg))
	out := make([]byte, 64, 96)
	for i := 0; i < 64; i++ {
		var kb byte
		if i < len(key) {
			kb = key[i]
		}
		in[i] = kb ^ 0x36
		out[i] = kb ^ 0x5c
	}
	in = append(in, msg...)
	out = append(out, sum256(in)...)
	return sum256(out)
}

// equalMAC compares two MACs in time independent of where they differ.
func equalMAC(a, b []byte) bool {
	if len(a) != len(b) {
		return false
	}
	var d byte
	for i := 0; i < len(a); i++ {
		d |= a[i] ^ b[i]
	}
	return d == 0
}
