// Package errors is gogo's errors: Go's New, Is and Unwrap, and one error
// code space, Code, whose values are errors too (Code has an Error
// method). Every package that reports why a call failed uses these
// numbers for the meanings they share, so a program that imports several
// of them can compare and switch on one set of codes: fs.Err and code.Err
// are Code, and err == errors.NotFound holds for an error from any of
// them. The C side defines the same numbers once, as GOGO_E_* in
// runtime/include/gogo_errors.h (tests/errors_test.go keeps the two
// equal, and Error's texts equal to gogo_strerror's).
//
// Code and the type New returns are reserved types: an error made of
// them can be sent to another module (a hot-loaded one), where it is the
// same error. The method calls and the equality work there too, whether
// that module imports gogo/errors or not.
//
// The space:
//
//	0        OK
//	1..35    shared meanings (below; 28..35 are free for later ones)
//	36..99   reserved, never shared codes (the C embedding API's
//	         results are the shared codes negated, plus its own -36)
//	>= 100   per package, each in its own block of 20:
//	         100..119 gogo/http, 120..139 gogo/sound (both unused so far)
//
// gogo/fs's fs.Err, gogo/code's code.Err and the Reason of a "tcp" or
// "tls" port's port.Closed (gogo/net's Normal ... TLS) take their values
// from this table; gogo/http (Upload, ClientUpload) and gogo/sound
// (Recorded.Err, Played.Err) return Code. A package's own codes, when it
// needs some, go in its block, never in 1..99.
//
// An actor that ends because of one of these failures exits with
// actor.Fail(code), actor.Failed + the code (gogo/actor's exit reasons
// 64..99): gogo/http's ListenFailed is actor.Fail(Busy). That is why
// shared codes stop at 35: 64 + 35 = 99 stays below the user exit codes
// from 100.
package errors

// Code is an error code: OK (0), a shared code, or a package's own. In an
// interface (an error) it is boxed in its reserved type.
//
//gogo:reserved 45
type Code int

// Error describes the code, in the words of the C side's gogo_strerror:
// "not found", "busy", ...; "error 120" for a code it does not know.
func (c Code) Error() string {
	switch c {
	case OK:
		return "ok"
	case NotFound:
		return "not found"
	case Exists:
		return "exists already"
	case NoMemory:
		return "out of memory"
	case TooMany:
		return "too many: a fixed table is full"
	case Busy:
		return "busy"
	case BadArg:
		return "bad argument"
	case Closed:
		return "closed"
	case IO:
		return "I/O error"
	case Timeout:
		return "timed out"
	case Unsupported:
		return "unsupported: a driver or mount is missing"
	case NoSpace:
		return "no space left"
	case BadPath:
		return "bad path"
	case IsDir:
		return "is a directory"
	case NotDir:
		return "not a directory"
	case NotEmpty:
		return "directory not empty"
	case NotMounted:
		return "not mounted"
	case BadImage:
		return "bad image"
	case Refused:
		return "connection refused"
	case Reset:
		return "connection reset"
	case NoRoute:
		return "no route"
	case BadCert:
		return "bad certificate"
	case NoTime:
		return "wall clock not set"
	case TLS:
		return "TLS error"
	case Overflow:
		return "too large"
	case BadURL:
		return "bad URL"
	case BadFormat:
		return "bad format"
	case BadVersion:
		return "unsupported image format version"
	}
	n, s := int(c), ""
	if n < 0 {
		n = -n
	}
	for {
		s = string([]byte{byte('0' + n%10)}) + s
		n /= 10
		if n == 0 {
			break
		}
	}
	if c < 0 {
		s = "-" + s
	}
	return "error " + s
}

// New returns an error whose Error is text. Two errors from New with the
// same text are equal (they are values, compared by their text), unlike
// Go's, which are equal only to themselves.
func New(text string) error { return errorString{text} }

// errorString is New's error.
//
//gogo:reserved 46
type errorString struct{ s string }

func (e errorString) Error() string { return e.s }

// Is reports whether err, or an error it wraps (its Unwrap() error, then
// that one's ...), equals target.
func Is(err, target error) bool {
	if err == nil || target == nil {
		return err == target
	}
	for err != nil {
		if err == target {
			return true
		}
		err = Unwrap(err)
	}
	return false
}

// Unwrap returns the error err wraps: the result of its Unwrap() error
// method, or nil if it has none.
func Unwrap(err error) error {
	if u, ok := err.(interface{ Unwrap() error }); ok {
		return u.Unwrap()
	}
	return nil
}

// The codes.
const (
	OK          Code = 0
	NotFound    Code = 1  // no such file, module, entry or name
	Exists      Code = 2  // the target exists already
	NoMemory    Code = 3  // out of memory, or over the caller's quota
	TooMany     Code = 4  // a fixed table is full (open files, modules, holders)
	Busy        Code = 5  // the resource is in use
	BadArg      Code = 6  // an argument that cannot be used
	Closed      Code = 7  // closed, not owned by the caller, or of the wrong kind
	IO          Code = 8  // a medium or transfer failed
	Timeout     Code = 9  // the other side did not answer in time
	Unsupported Code = 10 // this firmware lacks what it needs
	NoSpace     Code = 11 // the medium is full
	BadPath     Code = 12 // a path or name that breaks the rules
	IsDir       Code = 13 // a file operation on a directory
	NotDir      Code = 14 // a path segment before the last is not a directory
	NotEmpty    Code = 15 // removing a directory that has entries
	NotMounted  Code = 16 // unknown mount prefix, or the medium is missing
	BadImage    Code = 17 // not a valid image
	Refused     Code = 18 // the peer refused the connection
	Reset       Code = 19 // the peer reset the connection
	NoRoute     Code = 20 // no address, no gateway, or the interface went down
	BadCert     Code = 21 // the peer's certificate is untrusted, expired or for another name
	NoTime      Code = 22 // the wall clock is not set
	TLS         Code = 23 // any other TLS failure
	Overflow    Code = 24 // a value or a buffer is too large
	BadURL      Code = 25 // a URL, or a header value, that cannot be used
	BadFormat   Code = 26 // data in the wrong format
	BadVersion  Code = 27 // built for another image format
)
