// Package actor is the gogo actor API. Its functions (marked
// //gogo:builtin) exist only so programs type-check with the standard Go
// toolchain; the gogo compiler replaces every call with VM instructions, so
// the bodies are never executed. The functions with a body (Call, Fail,
// Register) are ordinary library code.
//
// The struct types ProcInfo, Reason, ExitMsg, DownMsg, Request and Options
// have fixed type indices 0-5 in every image (TYPE_* in runtime/vm/opcodes.h); keep
// their field order in sync with compiler.reservedTypes.
package actor

import "gogo/errors"

// PID identifies an actor.
//
//gogo:builtin
type PID struct{ _ int32 }

// NoPID is the zero PID, also written actor.PID{}: what a PID variable
// holds before it is set. It names no actor, local or remote, so a Send
// to it is dropped, a Monitor or Link of it reports NoProc at once (a
// DownMsg, or an exit signal), Kill and Unlink do nothing, and a Call to
// it fails at once. Whereis of an unknown name and a failed port.Open
// return it. Package-level variables are read-only: NoPID cannot be
// changed.
var NoPID = PID{}

// Ref is a VM-wide unique reference value; refs compare with == and !=.
//
//gogo:builtin
type Ref struct{ _ [2]int32 }

// ProcInfo describes an actor.
//
//gogo:reserved 0
type ProcInfo struct{ Memory int }

// Reason is why an actor exited.
//
//gogo:reserved 1
type Reason struct {
	Code int    // one of the reason codes below, a library failure (64..99), or a user code >= 100
	Func string // function a runtime error happened in, else ""
}

// ExitMsg is delivered to a linked actor that traps exits.
//
//gogo:reserved 2
type ExitMsg struct {
	From   PID
	Reason Reason
}

// DownMsg is delivered to a monitoring actor when the monitored one exits.
//
//gogo:reserved 3
type DownMsg struct {
	Ref    Ref
	From   PID
	Reason Reason
}

// Request is the message Call sends; answer it with Reply.
//
//gogo:reserved 4
type Request struct {
	From PID
	Ref  Ref
	Body any
}

// Options configures SpawnOpt.
//
//gogo:reserved 5
type Options struct {
	MaxMemory int // bytes; 0 means the platform default
}

// Reason codes (R_* in runtime/vm/opcodes.h). 10..63 are kept for the VM.
// 64..99 are failures a library reports as an exit: Failed plus a shared
// code of gogo/errors, Fail(code) (Fail(errors.Busy) is 69; gogo/http's
// ListenFailed is one). User codes start at 100.
const (
	Normal          = 0
	Killed          = 1
	OutOfMemory     = 2
	MailboxOverflow = 3
	NoProc          = 4
	DivZero         = 5
	BadCode         = 6
	Shutdown        = 7
	BadShift        = 8
	BadMsg          = 9  // sent a value that may not cross modules or nodes (a module's own struct, a func value)
	Panic           = 10 // panic(v), a failed type assertion or a method call on a nil interface
	NoConnection    = 11 // a remote actor's node became unreachable (gogo/node): in DownMsg and link signals
	Nil             = 12 // a nil pointer dereference or a write to a nil map
	Failed          = 64 // the base of library failures: Failed + a shared error code (1..35, gogo/errors)
)

// Fail is the exit reason of a failure that a shared error code of
// gogo/errors describes: Failed + int(code), 64..99 for the shared codes
// (1..35). Exit with it, actor.Exit(actor.Fail(errors.Busy)), so that a
// supervisor or a linked actor can tell the cause from the reason; Code -
// Failed gives the code back.
func Fail(code errors.Code) int { return Failed + int(code) }

// Spawn starts a new actor running f and returns its PID.
//
//gogo:builtin
func Spawn(f func()) PID { panic("gogo only") }

// SpawnLink starts a new actor running f, linked to the caller.
//
//gogo:builtin
func SpawnLink(f func()) PID { panic("gogo only") }

// SpawnOpt starts a new actor running f with the given options.
//
//gogo:builtin
func SpawnOpt(f func(), opts Options) PID { panic("gogo only") }

// Self returns the calling actor's PID.
//
//gogo:builtin
func Self() PID { panic("gogo only") }

// Send delivers msg to the actor to.
//
//gogo:builtin
func Send(to PID, msg any) { panic("gogo only") }

// Receive blocks until a message arrives and returns it.
//
//gogo:builtin
func Receive() any { panic("gogo only") }

// ReceiveTimeout waits at most ms milliseconds for a message; ok is false
// on timeout. ms == 0 only looks.
//
//gogo:builtin
func ReceiveTimeout(ms int) (msg any, ok bool) { panic("gogo only") }

// Info returns information about actor p.
//
//gogo:builtin
func Info(p PID) ProcInfo { panic("gogo only") }

// Link links the caller and p.
//
//gogo:builtin
func Link(p PID) { panic("gogo only") }

// Unlink removes the link between the caller and p.
//
//gogo:builtin
func Unlink(p PID) { panic("gogo only") }

// TrapExit turns exit signals into ExitMsg messages.
//
//gogo:builtin
func TrapExit(on bool) { panic("gogo only") }

// Exit ends the calling actor with the given reason code. When main exits
// with a code of 64 or more, gogo run and gogovm exit with it (a code
// above 255 is 255); see the book's chapter 12.
//
//gogo:builtin
func Exit(code int) { panic("gogo only") }

// Kill sends an exit signal with the given code to p.
//
//gogo:builtin
func Kill(p PID, code int) { panic("gogo only") }

// Monitor watches p; a DownMsg carrying the returned Ref arrives when p exits.
//
//gogo:builtin
func Monitor(p PID) Ref { panic("gogo only") }

// Demonitor cancels a monitor.
//
//gogo:builtin
func Demonitor(r Ref) { panic("gogo only") }

// MakeRef returns a new unique Ref.
//
//gogo:builtin
func MakeRef() Ref { panic("gogo only") }

// SendAfter sends msg to to after ms milliseconds (ms <= 0: at once,
// through the timer queue). The Ref cancels it (CancelTimer). The
// arguments are in Send's order, the delay last as in Call.
//
//gogo:builtin
func SendAfter(to PID, msg any, ms int) Ref { panic("gogo only") }

// CancelTimer cancels a SendAfter timer; false if it already fired.
//
//gogo:builtin
func CancelTimer(r Ref) bool { panic("gogo only") }

// Sleep pauses the calling actor for ms milliseconds.
//
//gogo:builtin
func Sleep(ms int) { panic("gogo only") }

// Now returns milliseconds since the VM started.
//
//gogo:builtin
func Now() int64 { panic("gogo only") }

// Call sends a Request with body req to to and waits at most timeoutMs
// milliseconds for the reply (other messages stay in the mailbox). err is
// nil if the reply came, else an errors.Code that says why it did not:
//
//	errors.Timeout       no reply within timeoutMs (timeoutMs <= 0: none yet)
//	errors.NoProc        to is no live local actor: it has exited, never
//	                     existed, is the zero PID or a port; at once
//	errors.NoConnection  to is a remote PID (gogo/node) this node cannot
//	                     reach: its node is not connected or went away
//	                     (also while Call waited), or the PID names
//	                     nothing here any more, or the node's table of
//	                     remote Calls in flight is full; at once
//
// reply is nil then. If a local server dies while the call is pending,
// Call does not return early: it fails with errors.Timeout when the time
// is up (monitor the server to notice its death sooner). So does the first
// Call to a remote actor that has exited on a node that is still up (its
// node drops the request and tells this one, so later Calls to that PID
// fail at once with errors.NoConnection, as a Monitor of it reports
// NoConnection).
// req is checked as Send checks a message: one that cannot be sent ends
// the caller (actor.BadMsg).
func Call(to PID, req any, timeoutMs int) (reply any, err error) {
	reply, code := call(to, req, timeoutMs)
	if code != 0 {
		return nil, errors.Code(code)
	}
	return reply, nil
}

// call is Call with the shared error code in place of the error (builtin
// B_CALL_ERR, image format 15.7).
//
//gogo:builtin
func call(to PID, req any, timeoutMs int) (any, int) { panic("gogo only") }

// Reply answers a Request.
//
//gogo:builtin
func Reply(req Request, reply any) { panic("gogo only") }

// Register names p (on this node: see gogo/node's Register to export a
// name to other nodes). err is nil, or an errors.Code: errors.NoProc if p
// is not a live local actor (it has exited, is the zero PID, a port or a
// remote PID; checked first), errors.Exists if the name is taken. A name
// is freed when its actor exits or the registrant unregisters it.
func Register(name string, p PID) error {
	if code := register(name, p); code != 0 {
		return errors.Code(code)
	}
	return nil
}

// register is Register with the shared error code in place of the error
// (builtin B_REGISTER_ERR, image format 15.7).
//
//gogo:builtin
func register(name string, p PID) int { panic("gogo only") }

// Whereis looks a registered name up; ok is false if no actor has it.
// It is a lookup in this VM's own table, like a map's comma-ok: it cannot
// fail otherwise, so it has no error, unlike gogo/node's Whereis, which
// asks another node over the network and can fail for the network's
// reasons (Timeout, NoConnection).
//
//gogo:builtin
func Whereis(name string) (PID, bool) { panic("gogo only") }

// Unregister removes a name; only the actor that registered it may.
//
//gogo:builtin
func Unregister(name string) { panic("gogo only") }
