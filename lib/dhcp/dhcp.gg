// Package dhcp is the gogo DHCP client, written in the gogo
// subset and compiled into every image that imports it.
//
// Start spawns the client actor, linked to the caller. It owns the
// "netif" port and sets the interface address from its lease (or from the
// configuration store); every net.Subscribe subscriber then gets net.Up,
// and net.Down when the lease is lost. The client renews at T1 (half the
// lease, unicast to the server), rebinds at T2 (7/8 of it, broadcast) and,
// at expiry, clears the address and starts over. Retransmissions back off
// on the actor clock: DISCOVER after 2, 4, 8, 16, 16... s; REQUEST 4 times
// the same way, then DISCOVER again; renew and rebind retry at half the
// time left, at least 1 s apart. A link loss while bound renews at once.
//
// Static configuration: if the configuration store has net.ip (dotted
// IPv4), DHCP is skipped and the address is net.ip with net.mask (default
// 255.255.255.0), net.gw and net.dns.
package dhcp

import (
	"gogo/actor"
	"gogo/bytes"
	"gogo/net"
	"gogo/port"
	"gogo/sys"
)

// Config configures Start.
type Config struct {
	TimeoutMs int // how long Start waits for an address; <= 0: 10000
}

// waitAddr is Start's request to the client: the reply (true) comes once
// the interface has an address.
type waitAddr struct{}

// Start starts the client actor, linked to the caller, and waits until the
// interface has an address (true) or cfg.TimeoutMs has passed (false; the
// client keeps trying). It is false at once if there is no network or the
// "netif" port is taken. The client exits with the caller.
func Start(cfg Config) bool {
	t := cfg.TimeoutMs
	if t <= 0 {
		t = 10000
	}
	r, ok := actor.Call(actor.SpawnLink(run), waitAddr{}, t)
	switch up := r.(type) {
	case bool:
		return ok && up
	}
	return false
}

// The client's state is an []int and an []int64 indexed by these
// constants (the subset has no pointers).
const (
	sState  = iota // one of the states below
	sXID           // transaction id
	sTries         // REQUESTs sent for the current offer
	sRetry         // next retransmission interval, ms
	sIP            // offered or leased address
	sServer        // server id
	sMask          // mask, gateway and DNS of the lease
	sGW
	sDNS
	sStatic // 1: the address is static (no lease to renew)
	sDown   // 1: the link was lost while holding a lease
	sLen
)

const (
	tDeadline = iota // next timeout
	tT2              // end of renewing
	tExpire          // end of the lease
	tLen
)

// Client states.
const (
	selecting  = iota // DISCOVER sent
	requesting        // REQUEST for an offer sent
	bound
	renewing  // after T1: REQUEST unicast to the server
	rebinding // after T2: REQUEST broadcast
)

// DHCP message types (option 53).
const (
	discover = 1
	offer    = 2
	request  = 3
	ack      = 5
	nak      = 6
)

const cookie = 0x63825363 // the DHCP magic cookie

func run() {
	st := make([]int, sLen)
	tm := make([]int64, tLen)
	n, err := port.Open("netif", net.IfConfig{})
	var u actor.PID
	if err == nil {
		u, err = port.Open("udp", net.UDP{Port: 68})
	}
	if err == nil && staticAddr(n) {
		st[sState] = bound
		st[sStatic] = 1
		tm[tDeadline] = -1 // never
	} else if err == nil {
		net.Subscribe()
		restart(st, tm, u)
	}
	var waiter actor.Request
	waiting := false
	for {
		var m any
		got := true
		if tm[tDeadline] < 0 {
			m = actor.Receive()
		} else {
			wait := tm[tDeadline] - actor.Now()
			if wait < 0 {
				wait = 0
			}
			m, got = actor.ReceiveTimeout(int(wait))
		}
		if !got {
			timeout(st, tm, n, u)
			continue
		}
		switch m := m.(type) {
		case actor.Request:
			if err != nil {
				actor.Reply(m, false)
				return // no network: nothing to do
			}
			if st[sState] >= bound {
				actor.Reply(m, true)
			} else {
				waiter = m
				waiting = true
			}
		case net.Datagram:
			if recv(st, tm, n, u, m.Data) && waiting {
				actor.Reply(waiter, true)
				waiting = false
			}
		case net.Down:
			if st[sState] >= bound && st[sStatic] == 0 {
				st[sDown] = 1
				if st[sState] == bound {
					tm[tDeadline] = actor.Now() // link lost: renew now
				}
			}
		case net.Up:
			// The link is back (the lease survived, so Up comes at once):
			// renew now rather than wait out a retry timer set while the
			// link was down. The Up that follows our own address change
			// does not count: sDown is set only by Down.
			if st[sDown] == 1 && st[sState] >= bound {
				tm[tDeadline] = actor.Now()
			}
			st[sDown] = 0
		}
	}
}

// staticAddr sets the address from the configuration store, if net.ip is
// set there.
func staticAddr(n actor.PID) bool {
	ip, ok := cfgIP("net.ip")
	if !ok {
		return false
	}
	mask, ok := cfgIP("net.mask")
	if !ok {
		mask = -256 // 255.255.255.0
	}
	gw, _ := cfgIP("net.gw")
	dns, _ := cfgIP("net.dns")
	actor.Send(n, net.SetAddr{IP: ip, Mask: mask, Gateway: gw, DNS: dns})
	return true
}

func cfgIP(key string) (int, bool) {
	s, ok := sys.Config(key)
	if !ok {
		return 0, false
	}
	return parseIP(s)
}

// parseIP parses a dotted IPv4 address a.b.c.d.
func parseIP(s string) (int, bool) {
	ip, part, digits, dots := 0, 0, 0, 0
	for i := 0; i <= len(s); i++ {
		if i == len(s) || s[i] == '.' {
			if digits == 0 || part > 255 {
				return 0, false
			}
			ip = ip<<8 | part
			part, digits = 0, 0
			if i < len(s) {
				dots++
			}
		} else if s[i] < '0' || s[i] > '9' || digits == 3 {
			return 0, false
		} else {
			part = part*10 + int(s[i]-'0')
			digits++
		}
	}
	return ip, dots == 3
}

// restart starts over: a new transaction, DISCOVER, backoff from 2 s.
func restart(st []int, tm []int64, u actor.PID) {
	st[sState] = selecting
	st[sDown] = 0 // a lease lost during an outage leaves nothing to renew
	st[sXID] = st[sXID]*1103515245 + int(actor.Now()) + 12345
	st[sRetry] = 2000
	send(st, tm, u, discover)
}

// send sends a DHCP message of type typ for the current state and, while
// there is no lease, sets the retransmission deadline.
func send(st []int, tm []int64, u actor.PID, typ int) {
	state := st[sState]
	b := make([]byte, 240, 300)
	b[0], b[1], b[2] = 1, 1, 6 // BOOTREQUEST over Ethernet; the stack fills chaddr
	put32(b, 4, st[sXID])
	dst := -1 // 255.255.255.255
	if state >= renewing {
		put32(b, 12, st[sIP]) // ciaddr
		if state == renewing {
			dst = st[sServer]
		}
	} else {
		b[10] = 128 // broadcast replies, please
	}
	put32(b, 236, cookie)
	b = append(b, 53, 1, byte(typ))
	if state == requesting {
		b = append(b, 50, 4, 0, 0, 0, 0, 54, 4, 0, 0, 0, 0)
		put32(b, 245, st[sIP])
		put32(b, 251, st[sServer])
	}
	b = append(b, 55, 3, 1, 3, 6, 255) // ask for mask, router, DNS
	actor.Send(u, net.SendTo{Addr: net.Addr{IP: dst, Port: 67}, Data: bytes.FromSlice(b)})
	if state < bound {
		tm[tDeadline] = actor.Now() + int64(st[sRetry])
		if st[sRetry] < 16000 {
			st[sRetry] = st[sRetry] * 2
		}
	}
}

// timeout handles the deadline of the current state.
func timeout(st []int, tm []int64, n, u actor.PID) {
	now := actor.Now()
	state := st[sState]
	if state == selecting {
		send(st, tm, u, discover)
		return
	}
	if state == requesting {
		st[sTries] = st[sTries] + 1
		if st[sTries] < 4 {
			send(st, tm, u, request)
		} else {
			restart(st, tm, u)
		}
		return
	}
	if state == bound {
		state = renewing
	} else if state == renewing && now >= tm[tT2] {
		state = rebinding
	} else if state == rebinding && now >= tm[tExpire] {
		setAddr(n, 0, 0, 0, 0) // lease lost: subscribers get Down
		restart(st, tm, u)
		return
	}
	st[sState] = state
	send(st, tm, u, request)
	end := tm[tT2]
	if state == rebinding {
		end = tm[tExpire]
	}
	wait := (end - now) / 2
	if wait < 1000 {
		wait = 1000
	}
	if now+wait > end {
		wait = end - now
	}
	tm[tDeadline] = now + wait
}

// recv handles a datagram from a server; true if it brought a lease.
func recv(st []int, tm []int64, n, u actor.PID, d bytes.Bytes) bool {
	state := st[sState]
	if d.Len() < 240 || d.At(0) != 2 || get32(d, 4) != st[sXID] || get32(d, 236) != cookie {
		return false
	}
	typ, server, lease, mask, gw, dns := 0, 0, 3600, -256, 0, 0
	for i := 240; i+1 < d.Len(); {
		code, l := int(d.At(i)), int(d.At(i+1))
		if code == 255 {
			break
		}
		if code == 0 {
			i++
			continue
		}
		i += 2
		if i+l > d.Len() {
			return false
		}
		if l == 1 && code == 53 {
			typ = int(d.At(i))
		} else if l >= 4 {
			v := get32(d, i)
			if code == 1 {
				mask = v
			} else if code == 3 {
				gw = v
			} else if code == 6 {
				dns = v
			} else if code == 51 {
				lease = v
			} else if code == 54 {
				server = v
			}
		}
		i += l
	}
	if typ == offer && state == selecting && server != 0 {
		st[sState] = requesting
		st[sIP] = get32(d, 16)
		st[sServer] = server
		st[sTries] = 0
		st[sRetry] = 2000
		send(st, tm, u, request)
		return false
	}
	if state == selecting || state == bound {
		return false
	}
	if typ == nak {
		if state != requesting {
			setAddr(n, 0, 0, 0, 0)
		}
		restart(st, tm, u)
		return false
	}
	if typ != ack {
		return false
	}
	ip := get32(d, 16)
	if state == requesting && (ip != st[sIP] || server != st[sServer]) {
		return false // not the offer we asked for
	}
	st[sState] = bound
	if server != 0 {
		st[sServer] = server
	}
	// A renewal may change anything, the address included: the stack then
	// sends a new Up.
	if state == requesting || ip != st[sIP] || mask != st[sMask] || gw != st[sGW] || dns != st[sDNS] {
		st[sIP], st[sMask], st[sGW], st[sDNS] = ip, mask, gw, dns
		setAddr(n, ip, mask, gw, dns)
	}
	ms := int64(lease) * 1000
	if lease < 0 { // 0xffffffff: infinite
		ms = 1000000000000000
	}
	now := actor.Now()
	tm[tDeadline] = now + ms/2
	tm[tT2] = now + ms*7/8
	tm[tExpire] = now + ms
	return true
}

func setAddr(n actor.PID, ip, mask, gw, dns int) {
	actor.Send(n, net.SetAddr{IP: ip, Mask: mask, Gateway: gw, DNS: dns})
}

// put32 stores v big-endian at b[i:i+4].
func put32(b []byte, i, v int) {
	b[i], b[i+1], b[i+2], b[i+3] = byte(v>>24), byte(v>>16), byte(v>>8), byte(v)
}

// get32 reads the big-endian int at d[i:i+4] (wrapping to negative from
// 0x80000000 up, like an IPv4 address as an int).
func get32(d bytes.Bytes, i int) int {
	return int(d.At(i))<<24 | int(d.At(i+1))<<16 | int(d.At(i+2))<<8 | int(d.At(i+3))
}
