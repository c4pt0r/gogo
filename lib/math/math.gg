// Package math is the gogo math library: a subset of Go's math for
// float64. It is a system package like gogo/sys: the compiler replaces every
// call with the B_FLOAT builtin (runtime/floatlib, outside the VM core),
// so the bodies are never executed, and a program that calls none of them
// pays nothing. Using floats at all makes an image require "float"
// (firmware built with the GOGO_FLOAT option).
//
// The functions follow Go's definitions, special cases included (NaN,
// infinities, signed zeros). Sqrt is correctly rounded. Go's other
// functions (Pow, Exp, Log, the trigonometric ones, Mod, Float64bits, ...)
// are not provided yet.
package math

// Mathematical constants (as in Go).
const (
	E   = 2.71828182845904523536028747135266249775724709369995957496696763
	Pi  = 3.14159265358979323846264338327950288419716939937510582097494459
	Phi = 1.61803398874989484820458683436563811772030917980576286213544862

	Sqrt2   = 1.41421356237309504880168872420969807856967187537694807317667974
	SqrtE   = 1.64872127070012814684865078831848183753460326935883478911914548
	SqrtPi  = 1.77245385090551602729816748334114518279754945612238712821380779
	SqrtPhi = 1.27201964951406896425242246173749149171560804184009624861664038

	Ln2    = 0.693147180559945309417232121458176568075500134360255254120680009
	Log2E  = 1 / Ln2
	Ln10   = 2.30258509299404568401799145468436420760110148862877297603332790
	Log10E = 1 / Ln10
)

// Floating-point limit values (as in Go): Max is the largest finite value
// of the type, SmallestNonzero the smallest positive (subnormal) one.
const (
	MaxFloat32             = 0x1p127 * (1 + (1 - 0x1p-23))
	SmallestNonzeroFloat32 = 0x1p-126 * 0x1p-23
	MaxFloat64             = 0x1p1023 * (1 + (1 - 0x1p-52))
	SmallestNonzeroFloat64 = 0x1p-1022 * 0x1p-52
)

// Integer limit values of gogo's integer types (int is 32 bits).
const (
	MaxInt   = 1<<31 - 1
	MinInt   = -1 << 31
	MaxInt32 = 1<<31 - 1
	MinInt32 = -1 << 31
	MaxInt64 = 1<<63 - 1
	MinInt64 = -1 << 63
	MaxUint8 = 1<<8 - 1
)

// Sqrt returns the square root of x: Sqrt(+Inf) = +Inf, Sqrt(±0) = ±0,
// Sqrt(x < 0) = NaN, Sqrt(NaN) = NaN.
//
//gogo:builtin
func Sqrt(x float64) float64 { panic("gogo only") }

// Floor returns the greatest integer value less than or equal to x.
//
//gogo:builtin
func Floor(x float64) float64 { panic("gogo only") }

// Ceil returns the least integer value greater than or equal to x.
//
//gogo:builtin
func Ceil(x float64) float64 { panic("gogo only") }

// Trunc returns the integer value of x (toward zero).
//
//gogo:builtin
func Trunc(x float64) float64 { panic("gogo only") }

// Round returns the nearest integer, rounding half away from zero.
//
//gogo:builtin
func Round(x float64) float64 { panic("gogo only") }

// RoundToEven returns the nearest integer, rounding ties to even.
//
//gogo:builtin
func RoundToEven(x float64) float64 { panic("gogo only") }

// Abs returns the absolute value of x.
//
//gogo:builtin
func Abs(x float64) float64 { panic("gogo only") }

// Copysign returns a value with the magnitude of f and the sign of sign.
//
//gogo:builtin
func Copysign(f, sign float64) float64 { panic("gogo only") }

// Signbit reports whether x is negative or negative zero.
//
//gogo:builtin
func Signbit(x float64) bool { panic("gogo only") }

// Inf returns positive infinity if sign >= 0, negative infinity if sign < 0.
//
//gogo:builtin
func Inf(sign int) float64 { panic("gogo only") }

// NaN returns an IEEE 754 "not-a-number" value.
//
//gogo:builtin
func NaN() float64 { panic("gogo only") }

// IsNaN reports whether f is a NaN.
//
//gogo:builtin
func IsNaN(f float64) (is bool) { panic("gogo only") }

// IsInf reports whether f is an infinity, according to sign: sign > 0,
// f = +Inf; sign < 0, f = -Inf; sign == 0, either.
//
//gogo:builtin
func IsInf(f float64, sign int) bool { panic("gogo only") }

// Max returns the larger of x or y: Max(x, +Inf) = +Inf, Max(x, NaN) =
// NaN, Max(+0, -0) = +0.
//
//gogo:builtin
func Max(x, y float64) float64 { panic("gogo only") }

// Min returns the smaller of x or y: Min(x, -Inf) = -Inf, Min(x, NaN) =
// NaN, Min(-0, +0) = -0.
//
//gogo:builtin
func Min(x, y float64) float64 { panic("gogo only") }
