// Package net is the gogo network API (import path gogo/net; the C stack is
// runtime/net/). Its function (marked //gogo:builtin) exists only so
// programs type-check; the gogo compiler replaces every call with VM
// instructions, so its body is never executed.
//
// The struct types below have fixed type indices 9-22 (and 41, DialTLS;
// 47-48, NodeLink and NodeEvent) in every image
// (TYPE_NET_* in runtime/vm/opcodes.h); keep their field order in sync with
// compiler.reservedTypes.
//
// IPv4 addresses are ints: a.b.c.d is a<<24 | b<<16 | c<<8 | d (addresses
// from 128.0.0.0 up are negative).
//
// Ports (port.Open):
//
//   - "netif", cfg IfConfig{}: the network interface. One owner at a time
//     (the DHCP actor). Its owner sets the address with SetAddr; an IP of 0
//     clears it, and so does closing the port. Without an address the stack
//     passes only DHCP: UDP from local port 68 to 255.255.255.255:67, and
//     UDP to port 68 from port 67. A BOOTP request sent from port 68 to
//     port 67 gets the interface MAC in its chaddr; BOOTP replies to port
//     68 for another chaddr are dropped.
//   - "udp", cfg UDP{Port} (0 picks a free port from 49152 up): send with
//     actor.Send(u, SendTo{Addr, Data}); datagrams arrive at the owner as
//     Datagram{From, Data}, Data a heap copy of the payload. A datagram that
//     would take the owner past its memory limit is dropped (the owner is
//     not killed; UDP has no retransmission); delivery leaves room for an
//     Up. A Call reply to an owner whose mailbox datagrams filled is an
//     ordinary message and can still kill it. A datagram to a host whose
//     Ethernet address is not known yet is dropped while the stack asks for
//     it (ARP); send again.
//   - "tcp", cfg Dial{IP, Port, TimeoutMs} (TimeoutMs 0: the retransmission
//     limit only): an active open. Open fails without an address, while
//     the link is down, to a broadcast or multicast address, or without a
//     free connection slot (4 in all; a TIME_WAIT or half-open inbound one
//     is reclaimed). The owner gets Connected, or port.Closed with
//     Refused, Timeout or NoRoute. The connection speaks the stream
//     protocol of every byte port (gogo/port): received bytes arrive as
//     port.Chunk (Dropped always 0), port.Out sends and each Out is
//     answered by port.Done once the peer acknowledged all of it, and
//     port.Closed ends it; every event's From is the connection's port.
//     See Shutdown and the Closed reasons below.
//   - "tls", cfg DialTLS{IP, Port, TimeoutMs, Host}: like "tcp", with TLS
//     1.2 on top (see DialTLS). At most one at a time: a second open fails.
//   - "tcp_listen", cfg Listen{Port}: the owner gets Accepted{Conn} for each
//     connection the peer completes; Conn is a "tcp" port owned by the
//     listener and paused (no Chunk, window 0) until port.Handoff gives it
//     to another actor or its owner sends it Resume{}. Inbound connections
//     never take the last free slot (a SYN that would is dropped; the peer
//     retries), so the device's own Dial always finds one.
//
// TCP is deliberately small: one segment in flight each way (window 1460
// bytes), in-order segments only, retransmission after 1 s doubling to 8
// s, given up (port.Closed{Timeout}) after 6 retransmissions. A peer whose
// window stays 0 gets 1-byte probes on the same timer, so a connection
// it never reopens is aborted the same way, about 39 s after its first
// probe (Closed{Timeout}). A received
// segment is acknowledged only once its Chunk is in the owner's mailbox:
// an owner near its memory limit is never killed, the peer resends instead
// (a Chunk leaves room for the control events; one that still does not
// fit waits until the owner has read some).
//
// Out: at most two in flight per connection (one being sent, one queued;
// an Out whose Done is still owed counts). A third, an empty one, one
// after Shutdown, or one on a connection that has ended gets Done{Seq: -1}
// and is not sent; the connection carries on. Data is pinned (or copied)
// on the owner's behalf until acknowledged; a small Out is copied into a
// Bytes handle held for the owner, so it is also refused when the VM's 64
// Bytes handles are all taken by other actors. When the connection ends,
// the Outs still in flight get Done{-1}, then the Closed comes.
//
// port.Closed: Reason Normal means the peer finished sending (it may still
// read: Out and Shutdown work until the port is closed). Any other reason:
// the connection is gone (this may follow a Normal one). After either,
// close the port.
//
// A connection lives only while the interface keeps its address: link
// loss, SetAddr to another address or IP 0, or the "netif" port closing
// (its owner exiting) ends every connection with port.Closed{NoRoute}, orphans
// included. Keep the netif owner (the DHCP actor) alive while connections
// should finish closing.
package net

import (
	"gogo/actor"
	"gogo/bytes"
	"gogo/errors"
)

// IfConfig configures the "netif" port.
//
//gogo:reserved 9
type IfConfig struct{}

// SetAddr is a command to the "netif" port (owner only).
//
//gogo:reserved 10
type SetAddr struct {
	IP, Mask, Gateway, DNS int
}

// Up is sent to subscribers when the interface is up (link up and an
// address set), and again when its address changes.
//
//gogo:reserved 11
type Up struct {
	IP, Gateway, DNS int
}

// Down is sent to subscribers when the interface goes down (link lost or
// address cleared).
//
//gogo:reserved 12
type Down struct{}

// Addr is an IPv4 address and port.
//
//gogo:reserved 13
type Addr struct {
	IP, Port int
}

// UDP configures a "udp" port.
//
//gogo:reserved 14
type UDP struct {
	Port int
}

// SendTo is a command to a "udp" port: send Data to Addr.
//
//gogo:reserved 15
type SendTo struct {
	Addr Addr
	Data bytes.Bytes
}

// Datagram is an event of a "udp" port: Data arrived from From.
//
//gogo:reserved 16
type Datagram struct {
	From Addr
	Data bytes.Bytes
}

// Subscribe makes the caller receive Up and Down; Up at once if the
// interface is up already. ok is false if there is no network or the
// subscriber table (4 live subscribers) is full. Subscribing twice is
// the same as once; a subscriber's exit ends it. An Up or Down never
// kills a subscriber: one that does not fit its memory limit is resent,
// with the state current then, once it has room.
//
//gogo:builtin
func Subscribe() (ok bool) { panic("gogo only") }

// Dial configures a "tcp" port: connect to IP:Port. TimeoutMs bounds the
// connection attempt (0: until the retransmission limit, about 39 s).
//
//gogo:reserved 17
type Dial struct {
	IP, Port, TimeoutMs int
}

// DialTLS configures a "tls" port: a "tcp" connection to IP:Port with TLS
// on top, to the server named Host (the SNI name, and the name its
// certificate is checked against). The port speaks the same messages as
// "tcp" (Connected, Shutdown and the port.Out, Done, Chunk and Closed of
// the stream protocol), only the bytes are the TLS plaintext; it is a separate config type, not a field of Dial,
// because a port's config type is fixed per driver and Dial is the "tcp"
// one. IP, Port and TimeoutMs are as in Dial (TimeoutMs bounds the connect
// and the handshake together). The certificate is always verified, there is
// no way to turn that off, and the check needs the wall clock (gogo/sys,
// set by gogo/sntp). Needs the firmware's "tls" driver.
//
// TimeoutMs 0 bounds the handshake at 30 s. Before the wall clock is set
// the port opens but at once gets Closed{NoTime} (nothing is sent). A
// certificate that is not trusted, not valid now or not for Host gives
// Closed{BadCert}; any other TLS failure Closed{TLS}; the peer closing
// during the handshake Closed{Reset}. Connected comes after the handshake.
// close_notify (or a plain FIN, as Go's crypto/tls accepts) is
// Closed{Normal}. Shutdown sends close_notify, then the FIN; closing the
// port before that went out resets the connection.
//
// Memory: the TLS state (about 23 KB: record buffers of 16 KB in and 4 KB
// out) is charged to the owner, which needs room for it and one Chunk on
// top of its heap, or the open fails: on a board with the default 16 KB
// actor limit, open it from an actor spawned with a larger MaxMemory
// (actor.SpawnOpt). A connection peaks at about 34 KB of TLS memory (the
// handshake's temporaries are not charged). Only one tls connection exists
// at a time; a second open fails while one is open. TLS 1.2 only.
//
// Truncation: a FIN at a record boundary also gives Closed{Normal}, so an
// attacker on the path can cut the stream short there unnoticed; frame
// what you read (a length, a terminator) and treat a short read as an
// error, never "read until close".
//
// Closed: at most one Normal, then at most one terminal Closed (any other
// reason; a graceful close ends with Normal alone) per connection; the Outs
// still in flight get Done{-1} before a terminal one.
//
//gogo:reserved 41
type DialTLS struct {
	IP, Port, TimeoutMs int
	Host                string
}

// Listen configures a "tcp_listen" port on local Port.
//
//gogo:reserved 18
type Listen struct {
	Port int
}

// Shutdown is a command to a "tcp" port: send FIN after the pending
// writes. After it, closing the port (or the owner's exit) lets the
// connection finish its close on its own instead of resetting it (an
// orphan; but the netif owner's exit discards it, see above). An orphan
// lives at most 20 s (GOGO_NET_ORPHAN_MS) from the close, then is reset
// whatever its progress.
//
//gogo:reserved 19
type Shutdown struct{}

// Resume is a command to an accepted "tcp" port: start delivering Chunks
// (port.Handoff does the same).
//
//gogo:reserved 20
type Resume struct{}

// Connected is sent to a "tcp" port's owner when the connection is up.
//
//gogo:reserved 21
type Connected struct{}

// Accepted is an event of a "tcp_listen" port: Conn is a new connection's
// "tcp" port, owned by the listener's owner and paused.
//
//gogo:reserved 22
type Accepted struct {
	Conn actor.PID
}

// NodeLink configures a "node" port (image format 15.5): one link of a
// distributed node, the bytes of one authenticated connection to a peer
// node. gogo/node opens it after its handshake; programs use gogo/node,
// not this port. Self is this node's id and Peer the peer's (ids are given
// by the server node, which is 1); Relay 1 makes the link the route to
// every node without a link of its own (a board's link to the server).
// Agent is the local actor that messages to a node's zero PID reach (the
// node's door: it answers name lookups only). Name is the peer's name. Key
// is the link's session key (32 bytes, from the handshake): every frame
// carries a MAC under it, and a frame whose MAC fails ends the link. Conn,
// if not the zero PID, is the link's "tcp" port: where the board can (on a
// host VM with real sockets) the node port takes its connection over and
// closes it, so a link costs one port, and sends a NodeEvent of Kind
// NodeCarried; it reads the connection from then on once its owner sends
// it net.Resume{} (after forwarding the Chunks of Conn it still had).
// Hello, if not empty, goes out first, as it is (the handshake's last
// frame).
// Frames from the peer go to the port as port.Out commands (from the
// port's owner only); frames for the peer come out as port.Chunk events.
// The port is charged nothing; it fails to open with a bad id or key, when
// 8 links are open, or when the VM's actor table reaches into the remote
// PID range (more than 61440 actors).
//
//gogo:reserved 47
type NodeLink struct {
	Self, Peer, Relay int
	Agent             actor.PID
	Name              string
	Key               bytes.Bytes
	Conn              actor.PID
	Hello             bytes.Bytes
}

// NodeEvent is an event of a "node" port: Kind NodeUp when the port opens
// (Node, Name: the peer; Agent: the peer's door, a remote PID) and, on a
// board's link to the server, when another board joins; Kind NodeDown when
// the server reports node Node gone (its PIDs are stale now).
//
//gogo:reserved 48
type NodeEvent struct {
	From       actor.PID
	Kind, Node int
	Agent      actor.PID
	Name       string
}

// NodeEvent kinds.
const (
	NodeUp      = 1
	NodeDown    = 2
	NodeCarried = 3 // the node port took Conn over (NodeLink)
	// NodeDoor: sent to the node port, NodeEvent{Kind: NodeDoor, Node: id}
	// asks for node id's door; the port answers with the same Kind and the
	// door as Agent (the zero PID if no link reaches the node). A door is
	// a remote PID like any other, made on demand.
	NodeDoor = 4
)

// The Reason of a "tcp" or "tls" port's port.Closed: the shared codes of
// gogo/errors (Normal is errors.OK), as plain ints like the field.
const (
	Normal  = int(errors.OK)
	Timeout = int(errors.Timeout)
	Refused = int(errors.Refused)
	Reset   = int(errors.Reset)
	NoRoute = int(errors.NoRoute)
	BadCert = int(errors.BadCert) // tls: the server's certificate is untrusted, expired or not for Host
	NoTime  = int(errors.NoTime)  // tls: the wall clock is not set (gogo/sntp, gogo/sys)
	TLS     = int(errors.TLS)     // tls: any other TLS failure (an alert, a bad record, out of memory)
)
